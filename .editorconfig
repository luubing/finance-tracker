# EditorConfig（https://editorconfig.org）：统一编码、缩进和文件结尾，Visual Studio / Rider / VS Code 都会自动读取。
# 这里只约定「编辑器能自动处理的格式」，不放 C# 代码风格 / 分析器规则，避免一夜之间冒出大批告警。
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
# 不统一设 end_of_line：仓库里存 LF，工作区行尾交给 .gitattributes 和各人的 core.autocrlf（下面只对脚本单独约定）

# 项目文件、配置、工作流：2 空格
[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

# Markdown：行尾两个空格是强制换行，不能裁掉
[*.md]
trim_trailing_whitespace = false

# 解决方案文件：Visual Studio 自己写的是 Tab
[*.sln]
indent_style = tab

# Shell 脚本必须是 LF（与 .gitattributes 一致）；批处理必须是 CRLF
[*.sh]
end_of_line = lf

[*.{bat,cmd}]
end_of_line = crlf

# Windows PowerShell 5.1 靠 BOM 识别 UTF-8，脚本里有中文，丢了 BOM 会乱码
[*.ps1]
charset = utf-8-bom
