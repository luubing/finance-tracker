# ===========================================
# FinanceTracker 打包配置文件
# 使用方法: 复制此文件为 config.env 并填写配置
# ===========================================

# === Android 签名配置 ===

# Keystore 文件路径 (相对于项目根目录)
ANDROID_KEYSTORE_PATH="build/myapp.keystore"

# Keystore 密码
ANDROID_KEYSTORE_PASSWORD="your_keystore_password"

# Key 别名
ANDROID_KEY_ALIAS="myapp"

# Key 密码
ANDROID_KEY_PASSWORD="your_key_password"


# === iOS 签名配置 (仅 macOS 需要) ===

# iOS 签名证书名称
IOS_SIGNING_CERTIFICATE="Apple Development: Your Name (XXXXXXXXXX)"

# iOS Provisioning Profile 名称
IOS_PROVISIONING_PROFILE="FinanceTracker Development"


# === 蒲公英配置 ===

# 蒲公英 API Key (必填)
# 获取地址: https://www.pgyer.com/account/api
PGYER_API_KEY="your_pgyer_api_key"

# 蒲公英安装密码 (可选，为空则无需密码)
PGYER_INSTALL_PASSWORD=""

# 蒲公英通道密码 (可选)
PGYER_CHANNEL_PASSWORD=""


# === 版本配置 ===

# 是否自动递增构建版本号 (true/false)
AUTO_INCREMENT_VERSION=true

# 自定义版本号 (为空则使用 csproj 中的版本)
CUSTOM_VERSION=""

# 自定义构建号 (为空则自动递增)
CUSTOM_BUILD_NUMBER=""
