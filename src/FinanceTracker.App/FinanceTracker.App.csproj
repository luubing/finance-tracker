<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>FinanceTracker.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>

		<!-- Display name -->
		<ApplicationTitle>记账本</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.finance.tracker.app</ApplicationId>
		<ApplicationIdGuid>04A24970-5FD1-4AF0-A3A4-F098A7C3D005</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- iOS 发布包默认运行 Mono 全 AOT 且不启用解释器（PublishAot 并未默认为 true），
	     此时运行时 IsDynamicCodeSupported=false，EF Core 会在首次访问实体属性 getter/setter 时抛出
	     "Model building is not supported when publishing with NativeAOT. Use a compiled model."
	     （该异常的真实判定条件是 RuntimeFeature.IsDynamicCodeSupported，错误消息有误导性）。
	     必须启用 Mono 解释器以恢复动态代码支持，EF 运行时模型构建与 LINQ 查询才能工作。
	     说明：EF 编译模型方案不可行——它不支持本项目用于软删除的全局查询过滤器（HasQueryFilter）。 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PublishAot>false</PublishAot>
		<MtouchInterpreter>all</MtouchInterpreter>
	</PropertyGroup>

	<ItemGroup>
		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#512BD4" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.30" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FinanceTracker.Core\FinanceTracker.Core.csproj" />
		<ProjectReference Include="..\FinanceTracker.Shared\FinanceTracker.Shared.csproj" />
		<ProjectReference Include="..\FinanceTracker.Infrastructure\FinanceTracker.Infrastructure.csproj" />
		<ProjectReference Include="..\FinanceTracker.Infrastructure.Sqlite\FinanceTracker.Infrastructure.Sqlite.csproj" />
		<ProjectReference Include="..\FinanceTracker.Web\FinanceTracker.Web.csproj" />
	</ItemGroup>

</Project>
