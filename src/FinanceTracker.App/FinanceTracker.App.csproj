<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>FinanceTracker.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>

		<!-- Display name -->
		<ApplicationTitle>记账本</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.finance.tracker.app</ApplicationId>
		<ApplicationIdGuid>04A24970-5FD1-4AF0-A3A4-F098A7C3D005</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- 云端 API 地址：构建时注入，仓库不内置任何线上域名（以前写死在 MauiProgram，仓库一公开就等于公开了线上服务地址）。
	     - 打包发布（dotnet publish）必须显式指定：-p:CloudApiBaseUrl=https://你的服务器/ ，没指定直接报错，避免打出一个连不上服务器的安装包
	     - 日常开发（dotnet build / IDE 调试）不指定时用本机开发地址，即 README「快速开始」里 dotnet run 起的 API（端口 5065）：Android 模拟器经 10.0.2.2 访问宿主机，其余平台用 localhost
	     - 取值写进程序集元数据（AssemblyMetadata），运行时由 FinanceTracker.Web 的 CloudApiBaseUrlResolver 读出并校验；
	       键名、校验规则与那里保持一致，CloudApiBaseUrlResolverTests 守着 -->
	<PropertyGroup>
		<_CloudApiBaseUrlSpecified Condition="'$(CloudApiBaseUrl)' != ''">true</_CloudApiBaseUrlSpecified>
		<CloudApiBaseUrl Condition="'$(CloudApiBaseUrl)' == '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">http://10.0.2.2:5065/</CloudApiBaseUrl>
		<CloudApiBaseUrl Condition="'$(CloudApiBaseUrl)' == ''">http://localhost:5065/</CloudApiBaseUrl>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>CloudApiBaseUrl</_Parameter1>
			<_Parameter2>$(CloudApiBaseUrl)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<Target Name="ValidateCloudApiBaseUrl" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(_IsPublishing)' == 'true' And '$(_CloudApiBaseUrlSpecified)' != 'true'"
		       Text="打包发布必须指定云端 API 地址：dotnet publish ... -p:CloudApiBaseUrl=https://你的服务器/ （仓库不内置线上域名，详见 README「构建与发布」）" />
		<!-- 含 @ 的值多半把用户名密码写进了地址：报错但不回显，避免凭据进构建日志 -->
		<Error Condition="$(CloudApiBaseUrl.Contains('@'))"
		       Text="CloudApiBaseUrl 不能包含用户名或密码（地址会随安装包一起公开）" />
		<Error Condition="!$(CloudApiBaseUrl.Contains('@')) And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(CloudApiBaseUrl)', '^\s*https?://(\[[0-9a-f:.]+\]|[^/\s?#@:\[\]]+)(:([0-9]{1,4}|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(/[^\s?#@]*)?\s*$', System.Text.RegularExpressions.RegexOptions.IgnoreCase))"
		       Text="CloudApiBaseUrl 必须是以 http:// 或 https:// 开头、带主机名、不带查询参数和片段的地址；端口（如有）须是 0-65535 的数字，例如 https://finance.example.com/" />
	</Target>

	<!-- iOS 发布包默认运行 Mono 全 AOT 且不启用解释器（PublishAot 并未默认为 true），
	     此时运行时 IsDynamicCodeSupported=false，EF Core 会在首次访问实体属性 getter/setter 时抛出
	     "Model building is not supported when publishing with NativeAOT. Use a compiled model."
	     （该异常的真实判定条件是 RuntimeFeature.IsDynamicCodeSupported，错误消息有误导性）。
	     必须启用 Mono 解释器以恢复动态代码支持，EF 运行时模型构建与 LINQ 查询才能工作。
	     说明：EF 编译模型方案不可行——它不支持本项目用于软删除的全局查询过滤器（HasQueryFilter）。 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PublishAot>false</PublishAot>
		<MtouchInterpreter>all</MtouchInterpreter>
	</PropertyGroup>

	<ItemGroup>
		<!-- Splash Screen：系统启动画面 = 纯色底 + 一张静态图（冷启动设计稿 docs/design/cold-start）。
		     Color = tokens.css 里的 ft-splash-bg 令牌；图居中，Logo 方块在系统启动画面与 Web 层加载页之间不动。
		     BaseSize 108 = 方块 96 + 四周各 6 的透明边：MAUI 在 Android 12+ 生成的 drawable 把图固定拉成 108dp，留这圈边方块才是 96。
		     （XML 注释里不能出现连续两个连字符，令牌名这里不带前缀的两个短横线。）
		     tokens.css、splash.svg、MainPage.xaml 与这里的取值必须一致，DesignTokensTests 校验。 -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#5C2EF7" BaseSize="108,108" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- App Icon：品牌渐变背景层 + 白色 wallet-outline 前景层，与启动画面、加载页同一个 Logo，点开图标不再变色 -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#5C2EF7" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.30" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FinanceTracker.Core\FinanceTracker.Core.csproj" />
		<ProjectReference Include="..\FinanceTracker.Shared\FinanceTracker.Shared.csproj" />
		<ProjectReference Include="..\FinanceTracker.Infrastructure\FinanceTracker.Infrastructure.csproj" />
		<ProjectReference Include="..\FinanceTracker.Infrastructure.Sqlite\FinanceTracker.Infrastructure.Sqlite.csproj" />
		<ProjectReference Include="..\FinanceTracker.Web\FinanceTracker.Web.csproj" />
	</ItemGroup>

</Project>
