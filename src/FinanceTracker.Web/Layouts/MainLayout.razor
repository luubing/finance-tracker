@using FinanceTracker.Web.Components
@using FinanceTracker.Web.Shell
@using Masa.Blazor.Presets.PageStack
@inherits LayoutComponentBase

<MApp>
    <MErrorHandler>
        @* 记一笔 Sheet：布局级常驻。必须渲染在页面栈之前、与页面栈同级——升起时下面的页面缩小变暗靠「同级后继」选择器
           （.ft-sheet-host--scale ~ .m-page-stack）完成，见 BottomSheet 的 ScaleBackground *@
        <AddBillSheet />

        <PPageStack TabRules="@_tabRules" FallbackUri="/">
            @Body
        </PPageStack>

        @* 悬浮玻璃 Tab 栏：在页面栈之外，只在四个 Tab 根页面显示（显示逻辑见 GlassTabBar） *@
        <GlassTabBar />
    </MErrorHandler>
</MApp>

@code {
    // 四个 Tab 根页面（首页 / 账单 / 统计 / 我的）常驻页面栈：切走再切回，滚动位置与筛选状态都保持
    private readonly HashSet<TabRule> _tabRules = TabNavigation.CreateTabRules();
}
