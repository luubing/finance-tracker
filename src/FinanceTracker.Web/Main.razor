@using Microsoft.AspNetCore.Components.Routing

<ErrorBoundary>
    <ChildContent>
        <Router AppAssembly="@typeof(Main).Assembly" AdditionalAssemblies="new[] { typeof(FinanceTracker.Web.Pages.Index).Assembly }">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layouts.MainLayout)" />
            </Found>
            <NotFound>
                <MContainer>
                    <MRow Justify="JustifyTypes.Center" Align="AlignTypes.Center" Style="height: 100vh;">
                        <MCol Cols="12" Class="text-center">
                            <MIcon Size="64" Color="grey lighten-1">mdi-alert-circle-outline</MIcon>
                            <div class="text-h4 grey--text text--lighten-1 mt-4">页面未找到</div>
                            <MButton Color="primary" Class="mt-4" Href="/">返回首页</MButton>
                        </MCol>
                    </MRow>
                </MContainer>
            </NotFound>
        </Router>
    </ChildContent>

    <ErrorContent>
        <div style="padding: 20px; color: #b71c1c; font-family: Consolas, monospace; font-size: 13px;">
            <h4 style="margin: 0 0 8px;">组件渲染发生异常:</h4>
            <pre style="white-space: pre-wrap; background: #f5f5f5; padding: 12px; border-radius: 4px; margin: 0;">@context</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>
