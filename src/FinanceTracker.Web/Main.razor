@using Microsoft.AspNetCore.Components.Routing

<MApp>
    <MErrorHandler>
        <Router AppAssembly="@typeof(Main).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" />
            </Found>
            <NotFound>
                <MContainer>
                    <MRow Justify="JustifyTypes.Center" Align="AlignTypes.Center" Style="height: 100vh;">
                        <MCol Cols="12" Class="text-center">
                            <MIcon Size="64" Color="grey lighten-1">mdi-alert-circle-outline</MIcon>
                            <div class="text-h4 grey--text text--lighten-1 mt-4">页面未找到</div>
                            <MButton Color="primary" Class="mt-4" Href="/">返回首页</MButton>
                        </MCol>
                    </MRow>
                </MContainer>
            </NotFound>
        </Router>
    </MErrorHandler>
</MApp>
