@page "/log-viewer"
@using FinanceTracker.Web.Components.Logs
@implements IDisposable
@inject ILogViewerService LogViewerService
@inject IPopupService PopupService
@inject IJSRuntime JSRuntime
@inject ILogger<LogViewer> Logger

@*
    错误日志（二级页面模板，设计稿 05 · 二级页面 / 07 · 逐页改动清单 /log-viewer）：
      · 右上角「⋯」菜单收起了 筛选 / 刷新 / 导出日志 / 清除日志（清除为红色，点后用 Alert 确认）
      · 概览：总日志数 / 今日 / 本周三栏卡 + 按级别分布 + 时间范围
      · 搜索框（消息、异常类型、来源、完整信息，不区分大小写；停顿 350 ms 提交）+ 条件条（级别、时间标签，点 × 单独移除）
      · 按天分组的日志列表（设置式分组卡片：级别图标块 + 标题 + 「时间 · 级别 · 来源」+ 箭头），「加载更多」分页（每次 20 条）
      · 点一行弹出半屏详情 Sheet（时间含毫秒 / 来源 / 异常类型 / 消息 / 完整异常信息 / 上下文 / 复制），替代旧页面的「行内展开」
    功能与改造前一致：级别 / 日期范围 / 关键字筛选、详情与复制、导出（仅按日期范围，写到缓存目录并提示路径）、清除（确认后删除全部日志文件）、
    统计概览、加载失败提示；数据层（LogViewerService）顺带修了三处既有缺陷（见 22 号 ticket：消息永远为空、级别 Critical 对不上 Fatal、导出目录不存在）。
    服务接口没变；提示仍走全局 Toast（PopupService 调用方式不变）。
*@

<SecondaryPage Title="错误日志" TestId="logs-page">
    <Actions>
        @* 「⋯」是菜单的锚点：菜单从它下方、右缘对齐弹出 *@
        <span class="ft-lnav__btnwrap" @ref="_moreAnchor">
            <GlassButton Round
                         Icon="mdi-dots-horizontal"
                         AriaLabel="@LogViewerPresentation.MoreLabel"
                         aria-haspopup="menu"
                         aria-expanded="@(_menuOpen ? "true" : "false")"
                         TestId="logs-more"
                         OnClick="OpenMenu" />
        </span>
    </Actions>
    <ChildContent>
        @if (_isLoading)
        {
            <GroupedList TestId="logs-skeleton" aria-hidden="true">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="ft-skeleton-row" aria-hidden="true">
                        <span class="ft-skeleton ft-skeleton--tile"></span>
                        <span class="ft-skeleton-row__main">
                            <span class="ft-skeleton ft-skeleton--title"></span>
                            <span class="ft-skeleton ft-skeleton--sub"></span>
                        </span>
                    </div>
                }
            </GroupedList>
        }
        else if (_loadFailed)
        {
            <EmptyState Icon="mdi-alert-circle-outline"
                        Title="@LogViewerPresentation.LoadFailedTitle"
                        Text="@LogViewerPresentation.LoadFailedText"
                        TestId="logs-failed">
                <Action>
                    <GlassButton Kind="ButtonKind.Soft" Large Icon="mdi-refresh" TestId="logs-retry" OnClick="ReloadAsync">重试</GlassButton>
                </Action>
            </EmptyState>
        }
        else if (_statistics.TotalCount == 0 && !_filter.HasAny)
        {
            @* 一条日志都没有：好消息，没有搜索框和概览可言 *@
            var empty = LogViewerPresentation.EmptyState(_filter);
            <EmptyState Icon="@empty.Icon" Title="@empty.Title" Text="@empty.Text" TestId="logs-empty" />
        }
        else
        {
            @* 概览：总数 / 今日 / 本周（口径是全部日志，不受下面的搜索与筛选影响） *@
            <section class="ft-summary ft-summary--even" aria-label="日志概览" data-testid="logs-summary">
                <div class="ft-summary__cell">
                    <span class="ft-summary__label">总日志数</span>
                    <span class="ft-summary__count" data-testid="logs-total" data-count="@_statistics.TotalCount">@LogViewerPresentation.NumberText(_statistics.TotalCount)</span>
                </div>
                <div class="ft-summary__cell">
                    <span class="ft-summary__label">今日日志</span>
                    <span class="ft-summary__count" data-testid="logs-today" data-count="@_statistics.TodayCount">@LogViewerPresentation.NumberText(_statistics.TodayCount)</span>
                </div>
                <div class="ft-summary__cell">
                    <span class="ft-summary__label">本周日志</span>
                    <span class="ft-summary__count" data-testid="logs-week" data-count="@_statistics.WeekCount">@LogViewerPresentation.NumberText(_statistics.WeekCount)</span>
                </div>
            </section>

            @if (_levelCounts.Count > 0)
            {
                <ul class="ft-logs__levels" aria-label="按级别分布" data-testid="logs-levels">
                    @foreach (var item in _levelCounts)
                    {
                        <li class="ft-logs__level" data-level="@item.Level" data-count="@item.Count">
                            <span class="ft-logs__dot ft-logs__dot--@LogViewerPresentation.StyleOf(item.Level).Tone" aria-hidden="true"></span>
                            <span>@item.Level</span>
                            <b>@LogViewerPresentation.NumberText(item.Count)</b>
                        </li>
                    }
                </ul>
            }

            @if (_statistics.TotalCount > 0)
            {
                <p class="ft-logs__range" data-testid="logs-range">@LogViewerPresentation.TimeRangeLabel：@LogViewerPresentation.TimeRangeText(_statistics.EarliestLog, _statistics.LatestLog, _today)</p>
            }

            @* 搜索框：不受控（内容由浏览器持有），换 @key 才会被清空；结果条数通过 role=status 播报给读屏 *@
            <SearchField @key="_searchEpoch"
                         Class="ft-logs__search"
                         TestId="logs-search"
                         Placeholder="@LogViewerPresentation.SearchPlaceholder"
                         AriaLabel="@LogViewerPresentation.SearchLabel"
                         ClearLabel="@LogViewerPresentation.SearchClearLabel"
                         MaxLength="LogViewerPresentation.SearchMaxLength"
                         StatusText="@LogViewerPresentation.SearchStatusText(_filter, _total, false)"
                         OnSearch="ApplyKeywordAsync" />

            @* 条件条：只出现已生效的条件；点文字 = 打开筛选 Sheet 调整，点 × = 单独移除 *@
            @if (_filter.HasConditions)
            {
                <div class="ft-chiprow ft-logs__chips" role="group" aria-label="筛选条件" data-testid="logs-chips">
                    @if (_filter.Levels.Count > 0)
                    {
                        var levelsText = LogViewerPresentation.LevelsText(_filter.Levels);
                        <ConditionChip Text="@levelsText"
                                       GroupLabel="@LogViewerPresentation.LevelDimension"
                                       OpenLabel="@LogViewerPresentation.ChipLabel(LogViewerPresentation.LevelDimension, levelsText)"
                                       RemoveLabel="@LogViewerPresentation.ChipRemoveLabel(LogViewerPresentation.LevelDimension, levelsText)"
                                       TestId="logs-chip-level"
                                       OnOpen="OpenFilter"
                                       OnRemove="RemoveLevelsAsync" />
                    }
                    @if (_filter.HasTimeRange)
                    {
                        var timeText = LogViewerPresentation.TimeText(_filter.Start, _filter.End, _today);
                        <ConditionChip Text="@timeText"
                                       GroupLabel="@LogViewerPresentation.TimeDimension"
                                       OpenLabel="@LogViewerPresentation.ChipLabel(LogViewerPresentation.TimeDimension, timeText)"
                                       RemoveLabel="@LogViewerPresentation.ChipRemoveLabel(LogViewerPresentation.TimeDimension, timeText)"
                                       TestId="logs-chip-time"
                                       OnOpen="OpenFilter"
                                       OnRemove="RemoveTimeAsync" />
                    }
                    <ChoiceChip Label="@LogViewerPresentation.ClearChipText"
                                Icon="mdi-filter-remove-outline"
                                TestId="logs-chip-clear"
                                OnClick="ClearConditionsAsync" />
                </div>
            }

            @if (_groups.Count == 0)
            {
                var empty = LogViewerPresentation.EmptyState(_filter);
                <EmptyState Icon="@empty.Icon" Title="@empty.Title" Text="@empty.Text" TestId="logs-empty">
                    <Action>
                        @if (_filter.HasAny)
                        {
                            <GlassButton Kind="ButtonKind.Soft" Large Icon="@(_filter.HasConditions ? "mdi-filter-remove-outline" : "mdi-magnify-close")" TestId="logs-empty-clear" OnClick="ClearAllAsync">@LogViewerPresentation.ClearConditionsText(_filter)</GlassButton>
                        }
                    </Action>
                </EmptyState>
            }
            else
            {
                <div data-testid="logs-list" data-loaded-count="@_items.Count" data-total="@_total">
                    @foreach (var group in _groups)
                    {
                        <section class="ft-day" data-testid="logs-day" data-date="@group.Key" @key="group.Key">
                            <header class="ft-day__head">
                                <h2 class="ft-day__title" data-testid="logs-day-title">@group.Title</h2>
                                <span class="ft-day__date">@group.DateText</span>
                                <span class="ft-day__totals" data-testid="logs-day-count">@group.CountText</span>
                            </header>
                            <GroupedList TestId="logs-day-group">
                                @foreach (var entry in group.Items)
                                {
                                    var current = entry;
                                    var style = LogViewerPresentation.StyleOf(current.Level);
                                    <ListCell @key="current.Id"
                                              Icon="@style.Icon"
                                              Tone="@style.Tone"
                                              Title="@LogViewerPresentation.RowTitle(current)"
                                              Subtitle="@LogViewerPresentation.RowSubtitle(current)"
                                              AriaLabel="@LogViewerPresentation.RowLabel(current)"
                                              Chevron
                                              TestId="log-row"
                                              data-id="@current.Id"
                                              data-level="@current.Level"
                                              aria-haspopup="dialog"
                                              OnClick="() => OpenDetail(current)" />
                                }
                            </GroupedList>
                        </section>
                    }
                </div>

                <p class="ft-logs__foot" role="status" data-testid="logs-footnote">@LogViewerPresentation.LoadedText(_items.Count, _total)</p>

                @if (HasMore)
                {
                    <div class="ft-logs__more">
                        <GlassButton Kind="ButtonKind.Soft" Busy="_isLoadingMore" TestId="logs-load-more" OnClick="LoadMoreAsync">加载更多</GlassButton>
                    </div>
                }
            }
        }
    </ChildContent>
</SecondaryPage>

@* 「⋯」菜单：筛选 / 刷新 / 导出 / 清除（红色）。没有日志时导出与清除置灰 *@
<PopoverMenu @bind-Visible="_menuOpen"
             Anchor="_moreAnchor"
             AriaLabel="@LogViewerPresentation.MoreLabel"
             TestId="logs-menu">
    <PopoverMenuItem Icon="mdi-filter-variant" Label="筛选" TestId="logs-menu-filter" OnClick="OpenFilter" />
    <PopoverMenuItem Icon="mdi-refresh" Label="刷新" TestId="logs-menu-refresh" OnClick="ReloadAsync" />
    <PopoverMenuItem Icon="mdi-export-variant" Label="导出日志" Disabled="@(_statistics.TotalCount == 0)" TestId="logs-menu-export" OnClick="ExportAsync" />
    <PopoverMenuItem Icon="mdi-delete-outline" Label="清除日志" Danger Disabled="@(_statistics.TotalCount == 0)" TestId="logs-menu-clear" OnClick="AskClear" />
</PopoverMenu>

@* 筛选 Sheet：编辑草稿，点「查看日志」才生效 *@
<LogFilterSheet @bind-Visible="_filterOpen"
                Applied="_filter"
                PresentLevels="_presentLevels"
                OnApply="ApplyFromSheetAsync" />

@* 详情 Sheet：Entry 在 Sheet 完全关闭（退出动画结束）后才清掉，退出动画期间内容不会先消失 *@
<LogDetailSheet @bind-Visible="_detailOpen"
                Entry="_detail"
                OnCopy="CopyAsync"
                OnClosed="OnDetailClosed" />

@* 清除确认（删除全部日志文件，不可恢复） *@
<GlassAlert @bind-Visible="_clearOpen"
            Title="@LogViewerPresentation.ClearTitle"
            Message="@LogViewerPresentation.ClearMessage(_statistics.TotalCount)"
            ConfirmText="@LogViewerPresentation.ClearConfirmText"
            Destructive
            OnConfirm="ClearConfirmedAsync"
            TestId="logs-clear-alert" />

@code {
    private ElementReference _moreAnchor;
    private bool _menuOpen;

    // 查询条件（搜索 + 筛选 Sheet）与结果
    private LogFilter _filter = LogFilter.None;
    private List<LogEntry> _items = new();
    private IReadOnlyList<LogDayGroup> _groups = [];
    private int _total;
    private int _page = 1;
    private LogStatistics _statistics = new();
    private IReadOnlyList<LogLevelCount> _levelCounts = [];
    private IReadOnlyList<string> _presentLevels = [];

    // 搜索框是不受控的（内容在浏览器里，服务端不回写）：需要从外部清空时 +1，搜索框换 @key 重建
    private int _searchEpoch;

    // 整页骨架只在首次进入时出现；之后改条件 / 刷新都保留旧内容直到新数据到达，不闪烁
    private bool _isLoading = true;
    private bool _isLoadingMore;
    private bool _loadFailed;
    private bool _disposed;

    // 连续改条件时有多次读取在途：只有最后一次的结果生效，过期的丢弃
    private int _loadVersion;

    // 「今天」的基准：日志时间戳按机器本地时区解析（与旧页面一致），分组的「今天 / 昨天」也按本机日期
    private DateTime _today = DateTime.Today;

    // 弹层
    private bool _filterOpen;
    private bool _detailOpen;
    private LogEntry? _detail;
    private bool _clearOpen;

    private bool HasMore => _items.Count < _total;

    // 注意：本应用为 Blazor Server（ServerPrerendered 渲染）时，预渲染阶段也会跑 OnInitializedAsync；
    // 读日志文件放到 OnAfterRenderAsync 首次渲染后，避免预渲染与交互阶段各读一遍
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ReloadAsync();
    }

    public void Dispose()
    {
        _disposed = true;
    }

    // ------------------------------------------------------------------ 取数

    private static List<string>? LevelList(LogFilter filter) =>
        filter.Levels.Count > 0 ? filter.Levels.ToList() : null;

    private bool IsStale(int version) => _disposed || version != _loadVersion;

    /// <summary>
    /// 按当前条件重新读第一页 + 概览。刷新、改条件、清除后都走这里；失败时给 Toast 并显示失败状态（可重试）。
    /// </summary>
    private async Task ReloadAsync()
    {
        var version = ++_loadVersion;
        var filter = _filter;

        List<LogEntry> logs;
        int total;
        LogStatistics statistics;
        try
        {
            (logs, total) = await LogViewerService.GetLogsAsync(filter.Start, filter.End, filter.Keyword, 1, LogViewerPresentation.PageSize, LevelList(filter));
            statistics = await LogViewerService.GetStatisticsAsync();
        }
        catch (Exception ex)
        {
            if (IsStale(version))
            {
                return;
            }

            Logger.LogWarning(ex, "加载错误日志失败");
            _loadFailed = true;
            _isLoading = false;
            StateHasChanged();
            await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.LoadFailedWithReason(ex.GetUserMessage()), AlertTypes.Error);
            return;
        }

        if (IsStale(version))
        {
            return;
        }

        _items = logs;
        _total = total;
        _page = 1;
        _statistics = statistics;
        _levelCounts = LogViewerPresentation.LevelDistribution(statistics.LevelCounts);
        _presentLevels = _levelCounts.Select(c => c.Level).ToList();
        _today = DateTime.Today;
        _groups = LogViewerPresentation.GroupByDay(_items, _today);
        _loadFailed = false;
        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadMoreAsync()
    {
        if (_isLoadingMore || !HasMore)
        {
            return;
        }

        _isLoadingMore = true;
        StateHasChanged();
        await Task.Yield();

        var version = _loadVersion;
        var filter = _filter;
        try
        {
            var (logs, total) = await LogViewerService.GetLogsAsync(filter.Start, filter.End, filter.Keyword, _page + 1, LogViewerPresentation.PageSize, LevelList(filter));
            if (IsStale(version))
            {
                return;
            }

            // 翻页期间有新日志写入时偏移会错位，同一条可能在两页都出现：按 Id 去重
            var known = _items.Select(item => item.Id).ToHashSet();
            var fresh = logs.Where(log => known.Add(log.Id)).ToList();
            _items.AddRange(fresh);

            // 一页都没取到新的（总数与实际对不上，例如文件在翻页间被清理）：到此为止，不让「加载更多」原地打转
            _total = fresh.Count == 0 ? _items.Count : total;
            _page++;
            _groups = LogViewerPresentation.GroupByDay(_items, _today);
        }
        catch (Exception ex)
        {
            if (IsStale(version))
            {
                return;
            }

            Logger.LogWarning(ex, "加载更多错误日志失败");
            await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.LoadFailedWithReason(ex.GetUserMessage()), AlertTypes.Error);
        }
        finally
        {
            _isLoadingMore = false;
            StateHasChanged();
        }
    }

    // ------------------------------------------------------------------ 搜索与条件

    private async Task ApplyKeywordAsync(string? text)
    {
        var next = _filter.WithKeyword(text);
        if (next.Keyword == _filter.Keyword)
        {
            return;
        }

        _filter = next;
        await ReloadAsync();
    }

    private void OpenFilter() => _filterOpen = true;

    private async Task ApplyFromSheetAsync(LogFilter applied)
    {
        // Sheet 只编辑级别与起止日期；搜索关键字沿用页面当前的
        _filter = _filter.WithLevels(applied.Levels).WithRange(applied.Start, applied.End);
        await ReloadAsync();
    }

    private async Task RemoveLevelsAsync()
    {
        _filter = _filter.WithLevels(null);
        await ReloadAsync();
    }

    private async Task RemoveTimeAsync()
    {
        _filter = _filter.WithRange(null, null);
        await ReloadAsync();
    }

    /// <summary>条件条上的「清除条件」：清掉级别与时间，保留搜索关键字</summary>
    private async Task ClearConditionsAsync()
    {
        _filter = _filter.ClearConditions();
        await ReloadAsync();
    }

    /// <summary>空状态里的「清除」：清掉全部条件，含搜索关键字（搜索框换 @key 重建以清空）</summary>
    private async Task ClearAllAsync()
    {
        _filter = LogFilter.None;
        _searchEpoch++;
        await ReloadAsync();
    }

    // ------------------------------------------------------------------ 详情与复制

    private void OpenDetail(LogEntry entry)
    {
        _detail = entry;
        _detailOpen = true;
    }

    private void OnDetailClosed()
    {
        _detail = null;
    }

    private async Task CopyAsync(LogEntry entry)
    {
        try
        {
            // 使用 JSRuntime 复制到剪贴板
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", LogViewerPresentation.CopyText(entry));
            await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.CopySuccessMessage, AlertTypes.Success);
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.CopyFailedWithReason(ex.Message), AlertTypes.Error);
        }
    }

    // ------------------------------------------------------------------ 菜单：导出 / 清除

    private void OpenMenu() => _menuOpen = true;

    /// <summary>
    /// 导出：写到缓存目录并提示路径（与改造前一致：只按日期范围导出，不受级别与关键字影响——服务接口没有这两个参数）。
    /// </summary>
    private async Task ExportAsync()
    {
        try
        {
            var fileName = $"finance-tracker-logs-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            var directory = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "FinanceTracker", "Cache");
            var filePath = Path.Combine(directory, fileName);

            var success = await LogViewerService.ExportLogsAsync(filePath, _filter.Start, _filter.End);

            if (success)
            {
                await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.ExportSuccessMessage(filePath), AlertTypes.Success);
            }
            else
            {
                await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.ExportFailedMessage, AlertTypes.Error);
            }
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.ExportFailedWithReason(ex.Message), AlertTypes.Error);
        }
    }

    private void AskClear() => _clearOpen = true;

    private async Task ClearConfirmedAsync()
    {
        try
        {
            var success = await LogViewerService.ClearLogsAsync();

            if (success)
            {
                await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.ClearSuccessMessage, AlertTypes.Success);

                // 日志都没了，搜索与筛选条件没有意义：一并清掉，落到「暂无错误日志」的空状态
                _filter = LogFilter.None;
                _searchEpoch++;
                await ReloadAsync();
            }
            else
            {
                await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.ClearFailedMessage, AlertTypes.Error);
            }
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync(LogViewerPresentation.ClearFailedWithReason(ex.Message), AlertTypes.Error);
        }
    }
}
