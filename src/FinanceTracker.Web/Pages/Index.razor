@page "/"
@using FinanceTracker.Core.Interfaces
@using FinanceTracker.Web.Services
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IAuthService AuthService
@inject IStatisticsService StatisticsService
@inject IBillService BillService
@inject AuthenticationService AuthStateService
@inject BillEventService BillEventService
@inject FinanceTracker.Core.Interfaces.IPendingBillService PendingBillService
@inject PageStackNavController NavController
@inject NavigationManager Navigation
@inject ILogger<Index> Logger
@inject IBudgetService BudgetService
@inject BudgetAlertService BudgetAlertService
@inject IPopupService PopupService

<PStackPageBar Title="记账本"
               CenterTitle
               Flat
               Color="primary">
    <ActionContent>
        <MButton Icon Disabled="@(_isLoading || _isRefreshing)" OnClick="RefreshData">
            <MIcon Color="white" Class="@(_isRefreshing ? "mdi-spin" : null)">mdi-refresh</MIcon>
        </MButton>
        <MButton Icon OnClick="NavigateToAddBill">
            <MIcon Color="white">mdi-plus</MIcon>
        </MButton>
    </ActionContent>
</PStackPageBar>

@if (_isLoading)
{
    <MContainer Class="d-flex justify-center align-center" Style="height: 200px;">
        <MProgressCircular Indeterminate Size="64" Color="primary" />
    </MContainer>
}
else if (_user != null)
{
    <MContainer Style="height: calc(100vh - 56px); overflow-y: scroll;">
        <!-- 财务概览卡片 -->
        <MCard Class="mb-4" Color="primary" Dark>
            <MCardText Class="pa-4">
                <div class="text-h6 mb-2">本月概览</div>
                <MRow>
                    <MCol Cols="4">
                        <div class="text-caption">收入</div>
                        <div class="text-body-1">¥@_monthlyIncome.ToString("N2")</div>
                    </MCol>
                    <MCol Cols="4">
                        <div class="text-caption">支出</div>
                        <div class="text-body-1">¥@_monthlyExpense.ToString("N2")</div>
                    </MCol>
                    <MCol Cols="4">
                        <div class="text-caption">结余</div>
                        <div class="text-body-1">¥@_monthlyBalance.ToString("N2")</div>
                    </MCol>
                </MRow>
            </MCardText>
        </MCard>

        <!-- 本月预算执行情况 -->
        @if (_budgetStatuses.Any())
        {
            <MCard Class="mb-4">
                <MCardTitle Class="pb-0">
                    <MIcon Class="mr-2" Color="primary">mdi-wallet</MIcon>
                    本月预算
                    <MSpacer />
                    <MButton Small Text Color="primary" OnClick="NavigateToBudgets">
                        管理
                    </MButton>
                </MCardTitle>
                <MCardText>
                    @foreach (var status in _budgetStatuses.Take(3))
                    {
                        <div class="mb-2">
                            <div class="d-flex justify-space-between text-body-2">
                                <span>
                                    @status.CategoryIcon @status.CategoryName
                                    @if (status.LedgerName != null)
                                    {
                                        <span class="text--secondary">（@status.LedgerName）</span>
                                    }
                                </span>
                                <span class="@(status.RemainingAmount < 0 ? "error--text" : null)">
                                    剩余 ¥@status.RemainingAmount.ToString("N2")
                                </span>
                            </div>
                            <MProgressLinear Value="@((double)Math.Min(status.UsagePercentage, 100m))"
                                             Color="@GetBudgetProgressColor(status.UsagePercentage)"
                                             Height="6"
                                             Rounded
                                             Class="mt-1" />
                        </div>
                    }
                    @if (_budgetStatuses.Count > 3)
                    {
                        <div class="text-caption text--secondary">
                            共 @_budgetStatuses.Count 项预算，点击"管理"查看全部
                        </div>
                    }
                </MCardText>
            </MCard>
        }

        <!-- 快捷操作 -->
        <MCard Class="mb-4">
            <MCardTitle Class="pb-0">
                <MIcon Class="mr-2" Color="primary">mdi-lightning-bolt</MIcon>
                快捷操作
            </MCardTitle>
            <MCardText>
                <MRow Dense>
                    <MCol Cols="4">
                        <MButton Block
                                 Outlined
                                 Class="py-1"
                                 Style="height: unset !important;"
                                 Color="primary"
                                 OnClick="NavigateToAddBill">
                            <div class="d-flex flex-column align-center">
                                <MIcon Size="24">mdi-plus-circle</MIcon>
                                <span class="text-caption">记一笔</span>
                            </div>
                        </MButton>
                    </MCol>
                    <MCol Cols="4">
                        <MButton Block
                                 Class="py-1"
                                 Outlined
                                 Color="primary"
                                 Style="height: unset !important;"
                                 OnClick="NavigateToBills">
                            <div class="d-flex flex-column align-center">
                                <MIcon Size="24">mdi-format-list-bulleted</MIcon>
                                <span class="text-caption">账单</span>
                            </div>
                        </MButton>
                    </MCol>
                    <MCol Cols="4">
                        <MButton Block
                                 Class="py-1"
                                 Outlined
                                 Color="primary"
                                 Style="height: unset !important;"
                                 OnClick="NavigateToPendingBills">
                            <div class="d-flex flex-column align-center">
                                @if (_pendingCount > 0)
                                {
                                    <MBadge Content="@_pendingCount.ToString()" Color="error" OffsetY="4">
                                        <MIcon Size="24">mdi-bell-check</MIcon>
                                    </MBadge>
                                }
                                else
                                {
                                    <MIcon Size="24">mdi-bell-check</MIcon>
                                }
                                <span class="text-caption">待确认</span>
                            </div>
                        </MButton>
                    </MCol>
                </MRow>
            </MCardText>
        </MCard>

        <!-- 最近账单 -->
        <MCard Class="mb-4">
            <MCardTitle Class="pb-0">
                <MIcon Class="mr-2" Color="primary">mdi-clock-outline</MIcon>
                最近账单
                <MSpacer />
                <MButton Small Color="primary" OnClick="NavigateToBills">
                    查看全部
                </MButton>
            </MCardTitle>
            <MCardText>
                @if (_isLoadingBills)
                {
                    <div class="text-center py-4">
                        <MProgressCircular Indeterminate Size="32" Color="primary" />
                    </div>
                }
                else if (!_recentBills.Any())
                {
                    <div class="text-center text--secondary py-4">
                        <MIcon Size="48" Color="grey lighten-1">mdi-receipt</MIcon>
                        <div class="mt-2">暂无账单记录</div>
                        <MButton Small Color="primary" Class="mt-2" OnClick="NavigateToAddBill">
                            记一笔
                        </MButton>
                    </div>
                }
                else
                {
                    <MList>
                        @foreach (var bill in _recentBills)
                        {
                            <MListItem Class="px-0">
                                <MListItemIcon Class="mr-2">
                                    <MIcon Size="36" Color="@(bill.Type == "Expense" ? "error" : "success")">
                                        @bill.CategoryIcon
                                    </MIcon>
                                </MListItemIcon>
                                <MListItemContent>
                                    <MListItemTitle>
                                        @bill.CategoryName
                                        @if (!string.IsNullOrEmpty(bill.Note))
                                        {
                                            <span class="text--secondary ml-2">- @bill.Note</span>
                                        }
                                    </MListItemTitle>
                                    <MListItemSubtitle>
                                        @bill.PaymentChannelName
                                        <span class="ml-2">@bill.TransactionTime.ToString("MM-dd HH:mm")</span>
                                    </MListItemSubtitle>
                                </MListItemContent>
                                <MListItemAction>
                                    <span class="@(bill.Type == "Expense" ? "error--text" : "success--text") text-subtitle-1">
                                        @(bill.Type == "Expense" ? "-" : "+")¥@bill.Amount.ToString("N2")
                                    </span>
                                </MListItemAction>
                            </MListItem>
                        }
                    </MList>
                }
            </MCardText>
        </MCard>
    </MContainer>
}

@code {
    private Core.Entities.User? _user;
    private bool _isLoading = true;

    // 月度统计数据
    private decimal _monthlyIncome;
    private decimal _monthlyExpense;
    private decimal _monthlyBalance;

    // 最近账单
    private List<BillModel> _recentBills = new();
    private bool _isLoadingBills;

    // 待确认账单数量（通知栏/短信自动捕获，角标展示）
    private int _pendingCount;

    // 预算执行情况（本月）
    private List<BudgetStatus> _budgetStatuses = new();

    // 手动刷新状态
    private bool _isRefreshing;

    protected override void OnInitialized()
    {
        AuthStateService.AuthStateChanged += OnAuthStateChanged;
        BillEventService.BillChanged += OnBillChanged;
        PendingBillService.PendingBillsChanged += OnPendingBillsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUser();
            StateHasChanged();
        }
    }

    private async void OnAuthStateChanged()
    {
        try
        {
            await LoadUser();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "认证状态变化后刷新用户信息失败");
        }
    }

    private async void OnBillChanged()
    {
        try
        {
            if (_user != null)
            {
                await Task.WhenAll(LoadMonthlyStatistics(), LoadRecentBills(), LoadBudgetStatus());
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "账单变更后刷新首页数据失败");
        }
    }

    public void Dispose()
    {
        AuthStateService.AuthStateChanged -= OnAuthStateChanged;
        BillEventService.BillChanged -= OnBillChanged;
        PendingBillService.PendingBillsChanged -= OnPendingBillsChanged;
    }

    private async void OnPendingBillsChanged(object? sender, EventArgs e)
    {
        try
        {
            _pendingCount = (await PendingBillService.GetPendingBillsAsync()).Count;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // 电路可能已关闭，忽略刷新失败
        }
    }

    /// <summary>
    /// 手动刷新首页数据（月度统计 + 最近账单 + 待确认账单数量）
    /// </summary>
    private async Task RefreshData()
    {
        if (_isRefreshing)
        {
            return;
        }

        _isRefreshing = true;
        StateHasChanged();

        try
        {
            if (_user == null)
            {
                await LoadUser();
            }

            if (_user != null)
            {
                await Task.WhenAll(LoadMonthlyStatistics(), LoadRecentBills(), LoadBudgetStatus());

                _pendingCount = (await PendingBillService.GetPendingBillsAsync()).Count;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "手动刷新首页数据失败");
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task LoadUser()
    {
        try
        {
            var userId = await AuthStateService.GetUserIdAsync();

            if (userId.HasValue)
            {
                _user = await AuthService.GetUserByIdAsync(userId.Value);
            }

            // 未登录则重定向到登录页
            if (_user == null)
            {
                Navigation.Replace("/login");
                return;
            }

            // 加载业务数据
            await Task.WhenAll(LoadMonthlyStatistics(), LoadRecentBills(), LoadBudgetStatus());

            // 加载待确认账单数量（角标）
            _pendingCount = (await PendingBillService.GetPendingBillsAsync()).Count;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载用户信息失败，将重定向到登录页面");
            Navigation.Replace("/login");
            return;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMonthlyStatistics()
    {
        try
        {
            var now = DateTime.Now;
            var statistics = await StatisticsService.GetMonthlyStatisticsAsync(
                _user!.Id, now.Year, now.Month);

            _monthlyIncome = statistics.TotalIncome;
            _monthlyExpense = statistics.TotalExpense;
            _monthlyBalance = statistics.NetIncome;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载月度统计失败");
        }
    }

    private async Task LoadRecentBills()
    {
        _isLoadingBills = true;
        try
        {
            var bills = await BillService.GetBillsAsync(
                _user!.Id,
                page: 1,
                pageSize: 5);

            _recentBills = bills.Select(b => new BillModel
            {
                Id = b.Id,
                Amount = b.Amount,
                Type = b.Type.ToString(),
                CategoryName = b.Category?.Name ?? "未知分类",
                CategoryIcon = b.Category?.Icon ?? "mdi-tag",
                PaymentChannelName = b.PaymentChannel?.Name ?? "未知渠道",
                PaymentChannelIcon = b.PaymentChannel?.Icon ?? "mdi-credit-card",
                TransactionTime = b.TransactionTime,
                Note = b.Note
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载最近账单失败");
        }
        finally
        {
            _isLoadingBills = false;
        }
    }

    private void NavigateToAddBill()
    {
        NavController.Push("/add-bill");
    }

    private void NavigateToBills()
    {
        NavController.Push("/bills");
    }

    private void NavigateToPendingBills()
    {
        NavController.Push("/pending-bills");
    }

    private void NavigateToStatistics()
    {
        NavController.Push("/statistics");
    }

    private void NavigateToBudgets()
    {
        NavController.Push("/budgets");
    }

    private async Task LoadBudgetStatus()
    {
        try
        {
            var now = DateTime.Now;
            _budgetStatuses = await BudgetService.GetBudgetStatusAsync(_user!.Id, now.Year, now.Month);

            // 超支时发送本地通知（每日最多一次）
            await BudgetAlertService.NotifyIfExceededAsync(_budgetStatuses, now.Year, now.Month);

            // 应用内超支提示
            var exceeded = _budgetStatuses.Where(s => s.UsagePercentage >= 100).ToList();
            if (exceeded.Any())
            {
                var names = string.Join("、", exceeded.Select(s => s.CategoryName));
                await PopupService.EnqueueSnackbarAsync($"预算超支提醒：{names} 本月预算已超支", AlertTypes.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载预算执行情况失败");
        }
    }

    /// <summary>
    /// 预算进度条颜色：≥100% 红色超支，≥80% 黄色预警，其余主题色
    /// </summary>
    private string GetBudgetProgressColor(decimal usagePercentage)
    {
        return usagePercentage switch
        {
            >= 100 => "error",
            >= 80 => "warning",
            _ => "primary"
        };
    }

    private class BillModel
    {
        public Guid Id { get; set; }
        public decimal Amount { get; set; }
        public string Type { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public string CategoryIcon { get; set; } = string.Empty;
        public string PaymentChannelName { get; set; } = string.Empty;
        public string PaymentChannelIcon { get; set; } = string.Empty;
        public DateTime TransactionTime { get; set; }
        public string? Note { get; set; }
    }
}
