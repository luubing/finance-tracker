@page "/"
@using Masa.Blazor.Presets.PageStack.NavController
@implements IDisposable
@inject IAuthService AuthService
@inject IStatisticsService StatisticsService
@inject IBillService BillService
@inject ILedgerService LedgerService
@inject IBudgetService BudgetService
@inject FinanceTracker.Core.Interfaces.IPendingBillService PendingBillService
@inject AuthenticationService AuthStateService
@inject BillEventService BillEventService
@inject PageDataGate DataGate
@inject BudgetAlertService BudgetAlertService
@inject AddBillSheetService BillSheet
@inject PageStackNavController NavController
@inject NavigationManager Navigation
@inject IPopupService PopupService
@inject ILogger<Index> Logger

@*
    首页（设计稿 01 · 四个 Tab 根页面 / screens 01-home）：
      Hero（品牌渐变铺到屏幕最顶端：标题、日期星期、带角标的通知入口、「本月支出」大数字、收入 / 结余小卡）
      → 待确认横幅（有待确认账单时才出现）→ 本月预算（总预算 + 重点分类预算，三色进度）→ 最近账单（「全部」进入账单 Tab）。
    没有「快捷操作」宫格：Tab 栏与「记一笔」圆钮已覆盖这些入口。
    状态栏：Hero 声明 data-statusbar-bg="dark"（浅色图标），滚出屏幕后命中的是页面背景（深色图标），由 immersive.js 判定。
    刷新：只有下拉手势（PullToRefresh，在 Hero 里），没有按钮形式的刷新入口（ADR 0007）；
    只重读本页数据，不触发云端同步（同步只在「我的」里手动触发）。
    数据口径沿用既有服务：月度统计（应用时区「本月」、区间左闭右开）、账单、预算概览——本页不新增查询。
*@

@if (_isLoading || _userId != Guid.Empty)
{
    @* data-ft-ready：首屏就绪标记，启动加载页（wwwroot/js/boot.js）据此交接——读完登录状态与首页数据才声明，骨架阶段不声明 *@
    <div class="ft-tabpage ft-home" data-scroll-root data-testid="home-page" aria-busy="@(_isLoading ? "true" : null)" data-ft-ready="@(_isLoading ? null : "home")">
        <header class="ft-hero" data-statusbar-bg="dark" data-testid="home-hero">
            <PullToRefresh OnRefresh="PullRefreshAsync" TestId="home-ptr" />

            <div class="ft-hero__bar">
                <div class="ft-hero__titles">
                    <h1 class="ft-hero__title" data-testid="home-title">记账本</h1>
                    <p class="ft-hero__date" data-testid="home-date">@HomePresentation.DateLine(_nowLocal)</p>
                </div>
                <div class="ft-hero__actions">
                    <button type="button"
                            class="ft-hero__btn"
                            aria-label="@HomePresentation.BellLabel(_pending.Count)"
                            data-testid="home-bell"
                            @onclick="OpenPending">
                        <i class="mdi mdi-bell-outline" aria-hidden="true"></i>
                        @if (_pending.Count > 0)
                        {
                            <span class="ft-hero__badge" data-testid="home-bell-badge" aria-hidden="true">@HomePresentation.BellBadge(_pending.Count)</span>
                        }
                    </button>
                </div>
            </div>

            <div class="ft-hero__metric">
                <p class="ft-hero__label">本月支出</p>
                @if (_isLoading)
                {
                    <span class="ft-skeleton ft-skeleton--hero-amount" aria-hidden="true"></span>
                }
                else
                {
                    <AmountDisplay Amount="_monthlyExpense" Size="AmountSize.Xl" FitWidth="true" TestId="home-expense" />
                }
            </div>

            <div class="ft-hero__cards">
                <div class="ft-herocard" data-testid="home-income-card">
                    <p class="ft-herocard__label"><i class="mdi mdi-arrow-down-circle-outline" aria-hidden="true"></i><span>收入</span></p>
                    @if (_isLoading)
                    {
                        <span class="ft-skeleton ft-skeleton--hero-card" aria-hidden="true"></span>
                    }
                    else
                    {
                        <AmountDisplay Amount="_monthlyIncome" Size="AmountSize.Lg" FitWidth="true" TestId="home-income" />
                    }
                </div>
                <div class="ft-herocard" data-testid="home-balance-card">
                    <p class="ft-herocard__label"><i class="mdi mdi-scale-balance" aria-hidden="true"></i><span>结余</span></p>
                    @if (_isLoading)
                    {
                        <span class="ft-skeleton ft-skeleton--hero-card" aria-hidden="true"></span>
                    }
                    else
                    {
                        <AmountDisplay Amount="_monthlyBalance" Size="AmountSize.Lg" FitWidth="true" TestId="home-balance" />
                    }
                </div>
            </div>
        </header>

        <div class="ft-tabpage__body">
            @if (_isLoading)
            {
                <GroupedList Class="ft-home__banner" TestId="home-skeleton">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="ft-skeleton-row" aria-hidden="true">
                            <span class="ft-skeleton ft-skeleton--tile"></span>
                            <span class="ft-skeleton-row__main">
                                <span class="ft-skeleton ft-skeleton--title"></span>
                                <span class="ft-skeleton ft-skeleton--sub"></span>
                            </span>
                        </div>
                    }
                </GroupedList>
            }
            else
            {
                @* 待确认横幅：有待确认账单时才出现，没有时不占位 *@
                @if (_pending.Count > 0)
                {
                    <GroupedList Class="ft-home__banner" TestId="home-banner-group">
                        <ListCell Icon="mdi-bell-check"
                                  Tone="red"
                                  Title="@HomePresentation.BannerTitle(_pending.Count)"
                                  Subtitle="@HomePresentation.BannerSubtitle(_pending)"
                                  Chevron
                                  TestId="home-pending-banner"
                                  OnClick="OpenPending" />
                    </GroupedList>
                }

                @if (_guide == HomeGuide.CreateLedger)
                {
                    @* 新用户：没有账本也没有账单——账单必须记在某个账本里，先引导新建账本 *@
                    <EmptyState Icon="mdi-book-outline" Title="还没有账本" Text="账单必须记在某个账本里，先新建一个吧" TestId="home-empty-ledger">
                        <Action>
                            <GlassButton Kind="ButtonKind.Brand" Large Icon="mdi-plus" TestId="home-create-ledger" OnClick="OpenCreateLedger">新建账本</GlassButton>
                        </Action>
                    </EmptyState>
                }
                else
                {
                    @if (_guide == HomeGuide.CreateLedgerHint)
                    {
                        @* 只有历史无账本的账单、没有账本：不挡住已有数据，只在上方给一行提示 *@
                        <GroupedList Class="ft-home__banner" TestId="home-ledger-hint-group">
                            <ListCell Icon="mdi-book-outline"
                                      Tone="orange"
                                      Title="还没有账本"
                                      Subtitle="新记账单需要先建一个账本"
                                      Chevron
                                      TestId="home-ledger-hint"
                                      OnClick="OpenCreateLedger" />
                        </GroupedList>
                    }

                    @* 本月预算：总预算 + 重点分类预算；没有预算时给出创建引导 *@
                    <SectionHeader Title="本月预算"
                                   ActionText="管理"
                                   ActionAriaLabel="管理预算"
                                   OnAction="OpenBudgets"
                                   TestId="home-budget-header"
                                   ActionTestId="home-budget-manage" />
                    @if (_budgetRows.Count > 0)
                    {
                        <GroupedList Footer="@_budgetFooter" TestId="home-budget-group">
                            @foreach (var row in _budgetRows)
                            {
                                <BudgetRow Model="row" />
                            }
                        </GroupedList>
                    }
                    else
                    {
                        <GroupedList TestId="home-budget-group">
                            <ListCell Icon="mdi-wallet"
                                      Tone="purple"
                                      Title="设置本月预算"
                                      Subtitle="设定额度，快超支时提醒你"
                                      Chevron
                                      TestId="home-budget-guide"
                                      OnClick="OpenBudgets" />
                        </GroupedList>
                    }

                    @* 最近账单：「全部」切换到账单 Tab；点按账单行进入编辑页；有账本没账单时引导记第一笔 *@
                    <SectionHeader Title="最近账单"
                                   ActionText="全部"
                                   ActionAriaLabel="查看全部账单"
                                   OnAction="OpenAllBills"
                                   TestId="home-recent-header"
                                   ActionTestId="home-recent-all" />
                    @if (_recentBills.Count > 0)
                    {
                        <GroupedList TestId="home-recent-group">
                            @foreach (var row in _recentBills)
                            {
                                <BillRow Model="row" OnClick="OpenBill" />
                            }
                        </GroupedList>
                    }
                    else
                    {
                        <GroupedList TestId="home-recent-group">
                            <EmptyState Icon="mdi-receipt" Title="还没有账单" Text="记下第一笔，这里会显示最近的账单" TestId="home-empty-bills">
                                <Action>
                                    <GlassButton Kind="ButtonKind.Brand" Large Icon="mdi-plus" TestId="home-first-bill" OnClick="OpenAddBill">记第一笔</GlassButton>
                                </Action>
                            </EmptyState>
                        </GroupedList>
                    }
                }
            }
        </div>
    </div>

    @* 新建账本（与账本页共用同一个 Sheet）：保存后重新加载，引导状态随之从「新建账本」变为「记第一笔」 *@
    <LedgerFormSheet @bind-Visible="_ledgerSheetVisible" UserId="_userId" OnSaved="ReloadAsync" />
}

@code {
    private Guid _userId;
    private bool _isLoading = true;
    private bool _disposed;

    // 应用时区的「现在」：Hero 的日期星期、账单行的「昨天」判断都用它（每次加载时更新）
    private DateTime _nowLocal = AppTimeZone.ToLocal(DateTime.UtcNow);

    // 月度统计（应用时区的本月）
    private decimal _monthlyIncome;
    private decimal _monthlyExpense;
    private decimal _monthlyBalance;

    // 最近账单与引导所需的两个事实：用户自己有几个账本（-1 = 还没取到，不显示引导）、有没有任何账单
    private IReadOnlyList<BillRowModel> _recentBills = [];
    private int _ledgerCount = -1;
    private HomeGuide _guide = HomeGuide.None;

    // 预算：全部 / 展示的重点项 / 脚注；超支提示每个预算只弹一次
    private List<BudgetStatus> _budgetStatuses = new();
    private IReadOnlyList<BudgetRowModel> _budgetRows = [];
    private string? _budgetFooter;
    private readonly HashSet<Guid> _alertedBudgetIds = new();

    // 待确认账单（通知栏 / 短信自动捕获）：角标、横幅都读它
    private IReadOnlyList<PendingBill> _pending = [];

    // 新建账本 Sheet
    private bool _ledgerSheetVisible;

    protected override void OnInitialized()
    {
        AuthStateService.AuthStateChanged += OnAuthStateChanged;
        BillEventService.BillChanged += OnBillChanged;
        PendingBillService.PendingBillsChanged += OnPendingBillsChanged;
        NavController.PageClosed += OnPageClosed;
    }

    // 注意：本应用为 Blazor Server（ServerPrerendered 渲染），OnInitializedAsync 阶段 JS interop 不可用，
    // 登录状态存在 localStorage 里，所以依赖它的初始化放到首次渲染之后。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserAsync();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        AuthStateService.AuthStateChanged -= OnAuthStateChanged;
        BillEventService.BillChanged -= OnBillChanged;
        PendingBillService.PendingBillsChanged -= OnPendingBillsChanged;
        NavController.PageClosed -= OnPageClosed;
    }

    // ------------------------------------------------------------------ 事件

    private void OnAuthStateChanged() => _ = RunOnUiAsync(LoadUserAsync, "认证状态变化后刷新用户信息失败");

    private void OnBillChanged() => _ = RunOnUiAsync(
        async () =>
        {
            if (_userId != Guid.Empty)
            {
                await LoadBusinessDataAsync();
            }
        },
        "账单变更后刷新首页数据失败");

    // 单独刷新角标也要与其它页面的读库排队；LoadPendingAsync 本身不进闸门（整页加载时它已经在闸门里了，信号量不可重入）
    private void OnPendingBillsChanged(object? sender, EventArgs e) => _ = RunOnUiAsync(() => DataGate.RunAsync(LoadPendingAsync), "待确认账单变更后刷新角标失败");

    private void OnPageClosed(object? sender, PageStackPageClosedEventArgs e)
    {
        // 二级页面关闭后重新加载（预算、账本、待确认账单、导入……都可能改了首页展示的数据）。
        // 记一笔 / 编辑账单是布局级的 Sheet，不经过页面栈；它保存时已经通过 BillChanged 刷新
        _ = RunOnUiAsync(
            async () =>
            {
                if (_userId != Guid.Empty)
                {
                    await LoadBusinessDataAsync();
                }
            },
            "二级页面关闭后刷新首页数据失败");
    }

    /// <summary>
    /// 在渲染线程上执行并重绘；失败只记日志（电路可能已关闭），不能把异常抛到事件源
    /// </summary>
    private async Task RunOnUiAsync(Func<Task> work, string failureMessage)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed)
                {
                    return;
                }

                await work();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "{Message}", failureMessage);
        }
    }

    // ------------------------------------------------------------------ 刷新

    /// <summary>下拉刷新（唯一的刷新入口）：转圈由 PullToRefresh 负责，这里只重新加载本页数据</summary>
    private async Task PullRefreshAsync() => await ReloadAsync();

    /// <summary>
    /// 重新加载本页数据（月度统计 + 最近账单 + 预算 + 账本数 + 待确认账单）。只读本地库，不联网、不同步
    /// </summary>
    private async Task ReloadAsync()
    {
        try
        {
            if (_userId == Guid.Empty)
            {
                await LoadUserAsync();
            }
            else
            {
                await LoadBusinessDataAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "刷新首页数据失败");
        }
    }

    // ------------------------------------------------------------------ 加载

    private async Task LoadUserAsync()
    {
        try
        {
            var userId = await AuthStateService.GetUserIdAsync();

            // 读用户也是读库（与「我的」页一致，经 PageDataGate 与其它 Tab 根页面排队）；只包这一次读取，后面的 LoadBusinessDataAsync 自己进闸门，不能嵌套
            var user = userId.HasValue ? await DataGate.RunAsync(() => AuthService.GetUserByIdAsync(userId.Value)) : null;

            // 未登录则重定向到登录页
            if (user is null)
            {
                _userId = Guid.Empty;
                Navigation.Replace("/login");
                return;
            }

            if (user.Id != _userId)
            {
                // 换了账号（退出后用别的手机号登录）：先清掉上一个用户的数据并回到骨架，不让旧数据闪一下
                ResetData();
                _userId = user.Id;
                _isLoading = true;
                await InvokeAsync(StateHasChanged);
            }

            await LoadBusinessDataAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            // 仅「认证失败」才需要重新登录（与 401 语义一致）
            Logger.LogWarning(ex, "登录状态失效，将重定向到登录页面");
            _userId = Guid.Empty;
            Navigation.Replace("/login");
        }
        catch (Exception ex)
        {
            // 其它失败（数据库读取、统计、待确认账单等）与登录无关：
            // 不能把已登录用户踢到登录页，提示真实原因并留在首页，用户可下拉刷新重试
            Logger.LogError(ex, "加载首页数据失败");
            await PopupService.EnqueueSnackbarAsync($"加载失败: {ex.GetUserMessage()}", AlertTypes.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetData()
    {
        _monthlyIncome = _monthlyExpense = _monthlyBalance = 0;
        _recentBills = [];
        _ledgerCount = -1;
        _guide = HomeGuide.None;
        _budgetStatuses = new List<BudgetStatus>();
        _budgetRows = [];
        _budgetFooter = null;
        _alertedBudgetIds.Clear();
        _pending = [];
    }

    // 首页几块数据读的是同一个 DbContext：MAUI Blazor Hybrid 里 Scoped 等同于应用级单例，Blazor Server 里是同一条电路。
    // EF Core 不允许同一个上下文并行执行查询（"A second operation was started on this context"），
    // 所以首页自己的几块要顺序读；而 Tab 根页面常驻、一次账单变更会让首页 / 账单页 / 统计页同时重新加载，
    // 所以整个加载还要经过 PageDataGate 与其它页面排队（同时也避免「下拉刷新」「账单变更事件」「二级页面关闭」几条入口重入）。
    private Task LoadBusinessDataAsync() => DataGate.RunAsync(async () =>
    {
        _nowLocal = AppTimeZone.ToLocal(DateTime.UtcNow);

        await LoadMonthlyStatisticsAsync();
        var hasBills = await LoadRecentBillsAsync();
        await LoadBudgetStatusAsync();
        await LoadLedgerCountAsync();
        await LoadPendingAsync();

        _guide = _ledgerCount < 0 ? HomeGuide.None : HomePresentation.ResolveGuide(_ledgerCount, hasBills);
    });

    private async Task LoadMonthlyStatisticsAsync()
    {
        try
        {
            // 「本月」按应用时区；统计服务内部区间左闭右开，口径与统计页一致
            var statistics = await StatisticsService.GetMonthlyStatisticsAsync(_userId, _nowLocal.Year, _nowLocal.Month);

            _monthlyIncome = statistics.TotalIncome;
            _monthlyExpense = statistics.TotalExpense;
            _monthlyBalance = statistics.NetIncome;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载月度统计失败");
        }
    }

    /// <returns>是否有任何账单（取不到时按「有」处理，不误显示空状态引导）</returns>
    private async Task<bool> LoadRecentBillsAsync()
    {
        try
        {
            var bills = await BillService.GetBillsAsync(_userId, page: 1, pageSize: HomePresentation.RecentBillCount);

            // 库里是 UTC：账单行展示应用时区的墙上时间；历史无账本的账单标注「未归属账本」
            _recentBills = bills.Select(b => BillPresentation.ToRow(b, _nowLocal, includeDate: true, viewerId: _userId)).ToList();
            return bills.Count > 0;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载最近账单失败");
            return true;
        }
    }

    private async Task LoadBudgetStatusAsync()
    {
        try
        {
            // 概览口径：有「全部账本」预算就展示它们；只设了账本级预算时回退展示账本级预算
            var statuses = await BudgetService.GetOverviewBudgetStatusAsync(_userId, _nowLocal.Year, _nowLocal.Month);
            var highlights = HomePresentation.PickBudgetHighlights(statuses);

            _budgetStatuses = statuses;
            _budgetRows = highlights.Select(BudgetPresentation.ToRow).ToList();
            _budgetFooter = HomePresentation.BudgetFooter(statuses.Count, highlights.Count);

            // 超支时发送本地通知（每日最多一次）
            await BudgetAlertService.NotifyIfExceededAsync(statuses, _nowLocal.Year, _nowLocal.Month);

            // 应用内超支提示：同一个预算只提示一次（下拉刷新、账单变更都会重新加载，不能每次都弹）
            var newlyExceeded = new List<BudgetStatus>();
            foreach (var status in statuses)
            {
                if (status.UsagePercentage >= BudgetPresentation.OverPercent && _alertedBudgetIds.Add(status.BudgetId))
                {
                    newlyExceeded.Add(status);
                }
            }

            if (newlyExceeded.Count > 0)
            {
                var names = string.Join("、", newlyExceeded.Select(s => s.DisplayName));
                await PopupService.EnqueueSnackbarAsync($"预算超支提醒：{names} 本月预算已超支", AlertTypes.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载预算执行情况失败");
        }
    }

    private async Task LoadLedgerCountAsync()
    {
        try
        {
            // 只数用户自己的账本（引导的是「先创建账本」）；只加入了共享账本的用户也会看到引导——已知局限，见 ticket 07 实现说明
            _ledgerCount = (await LedgerService.GetLedgersAsync(_userId)).Count;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载账本数量失败");
        }
    }

    private async Task LoadPendingAsync()
    {
        try
        {
            _pending = await PendingBillService.GetPendingBillsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载待确认账单失败");
        }
    }

    // ------------------------------------------------------------------ 导航

    private void OpenAddBill() => BillSheet.Open();

    // 点最近账单 = 编辑那一笔：与账单 Tab 共用「记一笔」Sheet 的编辑模式
    private void OpenBill(Guid billId) => BillSheet.OpenEdit(billId);

    private void OpenPending() => NavController.Push("/pending-bills");

    private void OpenBudgets() => NavController.Push("/budgets");

    // 账单是 Tab 根页面：切换到「账单」Tab，不能把 Tab 根页面压栈成二级页面
    private void OpenAllBills() => Navigation.NavigateTo("/bills");

    private void OpenCreateLedger() => _ledgerSheetVisible = true;
}
