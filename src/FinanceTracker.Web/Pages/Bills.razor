@page "/bills"
@using FinanceTracker.Core.Enums
@using FinanceTracker.Core.Interfaces
@inject IBillService BillService
@inject ICategoryService CategoryService
@inject IPaymentChannelService PaymentChannelService
@inject ILedgerService LedgerService
@inject IJSRuntime JSRuntime
@inject PageStackNavController NavController
@inject IPopupService PopupService
@inject BillEventService BillEventService
@inject ILedgerMemberService LedgerMemberService

<PStackPageBar Title="账单列表"
               CenterTitle
               Flat
               Color="primary">
    <ActionContent>
        <MButton Icon Disabled="_isRefreshing" OnClick="RefreshData">
            <MIcon Color="white" Class="@(_isRefreshing ? "mdi-spin" : null)">mdi-refresh</MIcon>
        </MButton>
        <MButton Icon OnClick="ToggleSelectMode">
            <MIcon Color="white">@(_selectMode ? "mdi-close" : "mdi-checkbox-multiple-marked-outline")</MIcon>
        </MButton>
    </ActionContent>
</PStackPageBar>

<MContainer Style="height: calc(100vh - 56px); overflow-y: scroll;">
    <!-- 筛选区域 -->
    <MRow>
        <MCol Cols="12">
            <MCard Class="mb-4">
                <MCardTitle>
                    <MIcon Class="mr-2">mdi-filter</MIcon>
                    筛选条件
                    <MSpacer />
                    <MButton  Color="primary" OnClick="ResetFilters">
                        重置
                    </MButton>
                </MCardTitle>

                <MCardText>
                    <MRow>
                        <MCol Cols="12" Sm="6" Md="3">
                            <MTextField @bind-Value="_filter.StartDate"
                                        Label="开始日期"
                                        Type="date"
                                        Outlined
                                        Dense
                                        HideDetails="true" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Md="3">
                            <MTextField @bind-Value="_filter.EndDate"
                                        Label="结束日期"
                                        Type="date"
                                        Outlined
                                        Dense
                                        HideDetails="true" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Md="3">
                            <MSelect @bind-Value="_filter.CategoryId"
                                     Items="_categories"
                                     ItemText="c => c.Name"
                                     ItemValue="c => (Guid?)c.Id"
                                     Label="分类"
                                     Outlined
                                     Dense
                                     Clearable
                                     HideDetails="true" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Md="3">
                            <MSelect @bind-Value="_filter.PaymentChannelId"
                                     Items="_paymentChannels"
                                     ItemText="c => c.Name"
                                     ItemValue="c => (Guid?)c.Id"
                                     Label="支付渠道"
                                     Outlined
                                     Dense
                                     Clearable
                                     HideDetails="true" />
                        </MCol>
                    </MRow>
                    <MRow>
                        <MCol Cols="12" Sm="6" Md="3">
                            <MButtonGroup Value="_filter.Type?.ToString()" ValueChanged="OnFilterTypeChanged">
                                <MButton Value="@((string?)null)" Color="default">全部</MButton>
                                <MButton Value="@("Expense")" Color="error">支出</MButton>
                                <MButton Value="@("Income")" Color="success">收入</MButton>
                            </MButtonGroup>
                        </MCol>
                        <MCol Cols="12" Sm="6" Md="3">
                            <MSelect @bind-Value="_filter.LedgerId"
                                     Items="_ledgers"
                                     ItemText="@GetLedgerDisplayText"
                                     ItemValue="l => (Guid?)l.Id"
                                     Label="账本"
                                     Outlined
                                     Dense
                                     Clearable
                                     HideDetails="true" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Md="3">
                            <MButton Color="primary" OnClick="LoadBills">
                                <MIcon Class="mr-2">mdi-magnify</MIcon>
                                查询
                            </MButton>
                        </MCol>
                    </MRow>
                </MCardText>
            </MCard>
        </MCol>
    </MRow>

    <!-- 批量操作栏（批量选择模式） -->
    @if (_selectMode)
    {
        <MRow Class="my-0">
            <MCol Cols="12">
                <MCard Class="mb-2">
                    <MCardText Class="d-flex align-center pa-2">
                        <div class="d-flex align-center mr-2" style="cursor: pointer;"
                             @onclick="() => OnSelectAllChanged(!_selectAll)">
                            <MIcon Color="primary">
                                @(_selectAll ? "mdi-checkbox-marked" : "mdi-checkbox-blank-outline")
                            </MIcon>
                            <span class="text-caption ml-1">全选</span>
                        </div>
                        <span class="text-caption text--secondary">已选 @_selectedBillIds.Count 笔</span>
                        <MSpacer />
                        <MButton Small Color="primary" Class="mr-1"
                                 Disabled="@(!_selectedBillIds.Any())"
                                 OnClick="ShowAssignDialog">
                            <MIcon Small Class="mr-1">mdi-book-plus</MIcon>
                            归属账本
                        </MButton>
                        <MButton Small Text Disabled="@(!_selectedBillIds.Any())" OnClick="ClearSelection">
                            清空
                        </MButton>
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>
    }

    <!-- 统计卡片 -->
    <MRow Class="my-0">
        <MCol Cols="6" Class="pr-1">
            <MCard Color="error" Dark>
                <MCardText Class="text-center pa-2">
                    <div class="text-caption">总支出</div>
                    <div class="text-subtitle-1 font-weight-bold">¥@_totalExpense.ToString("N2")</div>
                </MCardText>
            </MCard>
        </MCol>
        <MCol Cols="6" Class="pl-1">
            <MCard Color="success" Dark>
                <MCardText Class="text-center pa-2">
                    <div class="text-caption">总收入</div>
                    <div class="text-subtitle-1 font-weight-bold">¥@_totalIncome.ToString("N2")</div>
                </MCardText>
            </MCard>
        </MCol>
    </MRow>

    <!-- 账单列表 -->
    <MRow Class="my-0">
        <MCol Cols="12">
            @if (_isLoading)
            {
                <MContainer Class="d-flex justify-center align-center" Style="height: 200px;">
                    <MProgressCircular Indeterminate Size="64" Color="primary" />
                </MContainer>
            }
            else if (!_groupedBills.Any())
            {
                <MCard>
                    <MCardText Class="text-center">
                        <MIcon Size="64" Color="grey lighten-1">mdi-receipt</MIcon>
                        <div class="text-h6 grey--text text--lighten-1 mt-4">暂无账单记录</div>
                        <PPageStackLink Href="/add-bill">
                            <MButton Color="primary" Class="mt-4">
                                <MIcon Class="mr-2">mdi-plus</MIcon>
                                记一笔
                            </MButton>
                        </PPageStackLink>
                    </MCardText>
                </MCard>
            }
            else
            {
                @foreach (var group in _groupedBills)
                {
                    <MCard Class="mb-4">
                        <MCardTitle Class="pb-0">
                            <div>
                                <div class="text-h6">@group.Date.ToString("yyyy年MM月dd日")</div>
                                <div class="text-caption text--secondary">
                                    支出: ¥@group.TotalExpense.ToString("N2") | 收入: ¥@group.TotalIncome.ToString("N2")
                                </div>
                            </div>
                        </MCardTitle>

                        <MCardText>
                            <MList Class="px-0">
                                @foreach (var bill in group.Bills)
                                {
                                    <MListItem OnClick="() => OnBillClicked(bill)" Class="px-0">
                                        @if (_selectMode)
                                        {
                                            <div class="mr-2 d-flex align-center" style="cursor: pointer;"
                                                 @onclick="() => ToggleBillSelection(bill.Id)"
                                                 @onclick:stopPropagation>
                                                <MIcon Color="primary">
                                                    @(_selectedBillIds.Contains(bill.Id) ? "mdi-checkbox-marked" : "mdi-checkbox-blank-outline")
                                                </MIcon>
                                            </div>
                                        }
                                        else
                                        {
                                            <MListItemIcon Class="mr-2">
                                                <MIcon Size="28" Color="@(bill.Type == "Expense" ? "error" : "success")">
                                                    @(bill.Type == "Expense" ? "mdi-minus" : "mdi-plus")
                                                </MIcon>
                                            </MListItemIcon>
                                        }
                                        <MListItemContent>
                                            <MListItemTitle>
                                                <span>@bill.CategoryName</span>
                                                @if (!string.IsNullOrEmpty(bill.Note))
                                                {
                                                    <span class="text--secondary ml-2">- @bill.Note</span>
                                                }
                                            </MListItemTitle>
                                            <MListItemSubtitle>
                                                <MIcon Small Class="mr-1">@bill.PaymentChannelIcon</MIcon>
                                                @bill.PaymentChannelName
                                                @if (!string.IsNullOrEmpty(bill.LedgerName))
                                                {
                                                    <MChip XSmall Outlined Class="mx-1">
                                                        <MIcon XSmall Class="mr-1">@bill.LedgerIcon</MIcon>
                                                        @bill.LedgerName
                                                    </MChip>
                                                }
                                                <span class="ml-2">@bill.TransactionTime.ToString("HH:mm")</span>
                                            </MListItemSubtitle>
                                        </MListItemContent>
                                        <MListItemAction Class="d-flex align-center">
                                            <span class="@(bill.Type == "Expense" ? "error--text" : "success--text") text-h6">
                                                @(bill.Type == "Expense" ? "-" : "+")¥@bill.Amount.ToString("N2")
                                            </span>
                                            @if (!_selectMode)
                                            {
                                                <span class="ml-1" style="cursor: pointer;"
                                                      @onclick="() => ShowDeleteConfirm(bill)"
                                                      @onclick:stopPropagation>
                                                    <MIcon Small Color="error">mdi-delete</MIcon>
                                                </span>
                                            }
                                        </MListItemAction>
                                    </MListItem>
                                }
                            </MList>
                        </MCardText>
                    </MCard>
                }

                <!-- 加载更多 -->
                @if (_hasMore)
                {
                    <MContainer Class="d-flex justify-center pb-4">
                        <MButton Outlined Color="primary" OnClick="LoadMore" Loading="_loadingMore">
                            加载更多
                        </MButton>
                    </MContainer>
                }
            }
        </MCol>
    </MRow>
</MContainer>

<!-- 删除账单确认对话框 -->
<MDialog @bind-Value="_showDeleteDialog" MaxWidth="320">
    <MCard>
        <MCardTitle Class="text-h6">
            确认删除
        </MCardTitle>

        <MCardText>
            确定要删除这笔账单吗？删除后将从列表中移除。
        </MCardText>

        <MCardActions>
            <MSpacer />
            <MButton Text OnClick="CancelDelete">取消</MButton>
            <MButton Color="error" Loading="_isDeleting" OnClick="ConfirmDelete">删除</MButton>
        </MCardActions>
    </MCard>
</MDialog>

<!-- 批量归属账本对话框 -->
<MDialog @bind-Value="_showAssignDialog" MaxWidth="400">
    <MCard>
        <MCardTitle Class="text-h6">
            归属账本
        </MCardTitle>

        <MCardText>
            <div class="text-caption text--secondary mb-2">
                将已选的 @_selectedBillIds.Count 笔账单归属到账本（已归属的账单将被重新归属）
            </div>
            @if (_ledgers.Any())
            {
                <MSelect @bind-Value="_assignLedgerId"
                         Items="_ledgers"
                         ItemText="l => l.Name"
                         ItemValue="l => (Guid?)l.Id"
                         Label="目标账本"
                         Outlined
                         Dense
                         Clearable
                         HideDetails="true" />
                <div class="text-caption text--secondary mt-2">不选择账本表示移出已选账单的账本归属</div>
            }
            else
            {
                <div class="text-caption text--secondary">暂无账本，请先到“我的 - 账本管理”中创建</div>
            }
        </MCardText>

        <MCardActions>
            <MSpacer />
            <MButton Text OnClick="CloseAssignDialog">取消</MButton>
            <MButton Color="primary" Loading="_isAssigning"
                     Disabled="@(!_ledgers.Any() || _isAssigning)"
                     OnClick="ConfirmAssign">
                确定
            </MButton>
        </MCardActions>
    </MCard>
</MDialog>

@code {
    private bool _isLoading = true;
    private bool _loadingMore;
    private bool _hasMore = true;
    private int _currentPage = 1;
    private const int PageSize = 20;

    // 手动刷新状态
    private bool _isRefreshing;

    // 批量选择模式
    private bool _selectMode;
    private bool _selectAll;
    private HashSet<Guid> _selectedBillIds = new();

    // 删除账单
    private bool _showDeleteDialog;
    private bool _isDeleting;
    private BillModel? _deletingBill;

    // 批量归属账本
    private bool _showAssignDialog;
    private bool _isAssigning;
    private Guid? _assignLedgerId;

    private List<CategoryModel> _categories = new();
    private List<PaymentChannelModel> _paymentChannels = new();
    private List<LedgerModel> _ledgers = new();
    private List<BillGroup> _groupedBills = new();

    private decimal _totalExpense;
    private decimal _totalIncome;

    private FilterModel _filter = new();

    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        var userIdStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
        if (!string.IsNullOrEmpty(userIdStr) && Guid.TryParse(userIdStr, out var userId))
        {
            _userId = userId;
        }

        await LoadFilterData();
        await LoadBills();
    }

    private async Task LoadFilterData()
    {
        var categories = await CategoryService.GetCategoriesAsync(_userId);
        _categories = categories.Select(c => new CategoryModel
        {
            Id = c.Id,
            Name = c.Name,
            Icon = c.Icon,
            Type = c.Type
        }).ToList();

        var channels = await PaymentChannelService.GetPaymentChannelsAsync(_userId);
        _paymentChannels = channels.Select(c => new PaymentChannelModel
        {
            Id = c.Id,
            Name = c.Name,
            Icon = c.Icon
        }).ToList();

        var ledgers = await LedgerService.GetLedgersAsync(_userId);
        _ledgers = ledgers.Select(l => new LedgerModel
        {
            Id = l.Id,
            Name = l.Name,
            Icon = l.Icon,
            IsShared = false
        }).ToList();

        // 共享账本：筛选时账本内全部成员账单可见（BillService 已处理共享可见性）
        try
        {
            var sharedLedgers = await LedgerMemberService.GetSharedLedgersAsync(_userId);
            _ledgers.AddRange(sharedLedgers.Select(l => new LedgerModel
            {
                Id = l.Id,
                Name = l.Name,
                Icon = l.Icon,
                IsShared = true
            }));
        }
        catch
        {
            // 共享账本加载失败不影响自有账本
        }
    }

    private async Task LoadBills()
    {
        _isLoading = true;
        _currentPage = 1;
        _groupedBills.Clear();
        _selectedBillIds.Clear();
        _selectAll = false;

        try
        {
            var billModels = await FetchBillsAsync(_currentPage);

            GroupBills(billModels);

            _hasMore = billModels.Count == PageSize;
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"加载失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// 手动刷新账单列表（保持当前筛选条件）
    /// </summary>
    private async Task RefreshData()
    {
        if (_isRefreshing)
        {
            return;
        }

        _isRefreshing = true;
        StateHasChanged();

        try
        {
            await LoadFilterData();
            await LoadBills();
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 按筛选条件获取指定页的账单
    /// </summary>
    private async Task<List<BillModel>> FetchBillsAsync(int page)
    {
        DateTime? startDate = !string.IsNullOrEmpty(_filter.StartDate)
            ? DateTime.Parse(_filter.StartDate)
            : null;

        DateTime? endDate = !string.IsNullOrEmpty(_filter.EndDate)
            ? DateTime.Parse(_filter.EndDate).AddDays(1).AddSeconds(-1)
            : null;

        var bills = await BillService.GetBillsAsync(
            _userId,
            startDate,
            endDate,
            _filter.CategoryId,
            _filter.PaymentChannelId,
            _filter.LedgerId,
            _filter.Type,
            page,
            PageSize);

        return bills.Select(b => new BillModel
        {
            Id = b.Id,
            Amount = b.Amount,
            Type = b.Type.ToString(),
            CategoryId = b.CategoryId,
            CategoryName = b.Category?.Name ?? "未知分类",
            CategoryIcon = b.Category?.Icon ?? "mdi-tag",
            PaymentChannelId = b.PaymentChannelId,
            PaymentChannelName = b.PaymentChannel?.Name ?? "未知渠道",
            PaymentChannelIcon = b.PaymentChannel?.Icon ?? "mdi-credit-card",
            LedgerName = b.Ledger?.Name,
            LedgerIcon = b.Ledger?.Icon ?? "mdi-book",
            TransactionTime = b.TransactionTime,
            Note = b.Note
        }).ToList();
    }

    private async Task LoadMore()
    {
        if (_loadingMore) return;

        _loadingMore = true;
        _currentPage++;

        try
        {
            var billModels = await FetchBillsAsync(_currentPage);

            GroupBills(billModels);

            _hasMore = billModels.Count == PageSize;
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"加载失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    /// <summary>
    /// 账单变更（删除/归属账本）后重新加载，保持已加载的页数
    /// </summary>
    private async Task ReloadBills()
    {
        var lastLoadedPage = _currentPage;
        _isLoading = true;
        _currentPage = 1;
        _groupedBills.Clear();

        try
        {
            var hasMore = true;

            for (var page = 1; page <= lastLoadedPage && hasMore; page++)
            {
                var billModels = await FetchBillsAsync(page);
                GroupBills(billModels);
                hasMore = billModels.Count == PageSize;
                _currentPage = page;
            }

            _hasMore = hasMore;
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"加载失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GroupBills(List<BillModel> bills)
    {
        var groups = bills
            .GroupBy(b => b.TransactionTime.Date)
            .OrderByDescending(g => g.Key)
            .Select(g => new BillGroup
            {
                Date = g.Key,
                Bills = g.OrderByDescending(b => b.TransactionTime).ToList(),
                TotalExpense = g.Where(b => b.Type == "Expense").Sum(b => b.Amount),
                TotalIncome = g.Where(b => b.Type == "Income").Sum(b => b.Amount)
            })
            .ToList();

        _groupedBills.AddRange(groups);

        _totalExpense = _groupedBills.Sum(g => g.TotalExpense);
        _totalIncome = _groupedBills.Sum(g => g.TotalIncome);
    }

    private void OnFilterTypeChanged(StringNumber value)
    {
        _filter.Type = value?.ToString() switch
        {
            "Expense" => BillType.Expense,
            "Income" => BillType.Income,
            _ => null
        };
    }

    private async Task ResetFilters()
    {
        _filter = new FilterModel();
        await LoadBills();
    }

    private void EditBill(Guid billId)
    {
        NavController.Push($"/add-bill/{billId}");
    }

    /// <summary>
    /// 点击账单项：批量选择模式下切换选中状态，否则进入编辑页
    /// </summary>
    private void OnBillClicked(BillModel bill)
    {
        if (_selectMode)
        {
            ToggleBillSelection(bill.Id);
        }
        else
        {
            EditBill(bill.Id);
        }
    }

    /// <summary>
    /// 切换批量选择模式（进入时清空已选，退出时重置全选状态）
    /// </summary>
    private void ToggleSelectMode()
    {
        _selectMode = !_selectMode;
        _selectedBillIds.Clear();
        _selectAll = false;
    }

    private void ToggleBillSelection(Guid billId)
    {
        if (!_selectedBillIds.Remove(billId))
        {
            _selectedBillIds.Add(billId);
        }

        SyncSelectAllState();
    }

    private void OnSelectAllChanged(bool selectAll)
    {
        _selectAll = selectAll;

        if (_selectAll)
        {
            foreach (var group in _groupedBills)
            {
                foreach (var bill in group.Bills)
                {
                    _selectedBillIds.Add(bill.Id);
                }
            }
        }
        else
        {
            _selectedBillIds.Clear();
        }
    }

    /// <summary>
    /// 根据已选数量同步全选复选框状态
    /// </summary>
    private void SyncSelectAllState()
    {
        var totalCount = _groupedBills.Sum(g => g.Bills.Count);
        _selectAll = totalCount > 0 && _selectedBillIds.Count >= totalCount;
    }

    private void ClearSelection()
    {
        _selectedBillIds.Clear();
        _selectAll = false;
    }

    /// <summary>
    /// 显示删除账单确认对话框
    /// </summary>
    private void ShowDeleteConfirm(BillModel bill)
    {
        _deletingBill = bill;
        _showDeleteDialog = true;
    }

    private void CancelDelete()
    {
        _showDeleteDialog = false;
        _deletingBill = null;
    }

    /// <summary>
    /// 确认删除账单（软删除，并通知其他页面刷新数据）
    /// </summary>
    private async Task ConfirmDelete()
    {
        if (_deletingBill == null || _isDeleting)
        {
            return;
        }

        _isDeleting = true;

        try
        {
            var success = await BillService.DeleteBillAsync(_deletingBill.Id, _userId);

            if (success)
            {
                await PopupService.EnqueueSnackbarAsync("账单已删除", AlertTypes.Success);
                BillEventService.NotifyBillChanged();
                _showDeleteDialog = false;
                await ReloadBills();
            }
            else
            {
                await PopupService.EnqueueSnackbarAsync("账单不存在或已删除", AlertTypes.Warning);
            }
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"删除失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _isDeleting = false;
            _deletingBill = null;
        }
    }

    private void ShowAssignDialog()
    {
        if (!_selectedBillIds.Any())
        {
            return;
        }

        _assignLedgerId = null;
        _showAssignDialog = true;
    }

    private void CloseAssignDialog()
    {
        _showAssignDialog = false;
        _assignLedgerId = null;
    }

    /// <summary>
    /// 确认批量归属账本（清空目标账本表示移出账本归属），并通知其他页面刷新数据
    /// </summary>
    private async Task ConfirmAssign()
    {
        if (!_selectedBillIds.Any() || _isAssigning)
        {
            return;
        }

        _isAssigning = true;

        try
        {
            var count = await BillService.AssignBillsToLedgerAsync(
                _selectedBillIds.ToList(),
                _userId,
                _assignLedgerId);

            await PopupService.EnqueueSnackbarAsync(
                _assignLedgerId.HasValue
                    ? $"已将 {count} 笔账单归属到账本"
                    : $"已将 {count} 笔账单移出账本",
                AlertTypes.Success);

            BillEventService.NotifyBillChanged();

            _showAssignDialog = false;
            _selectedBillIds.Clear();
            _selectAll = false;

            await ReloadBills();
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"归属账本失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _isAssigning = false;
        }
    }

    private class FilterModel
    {
        public string? StartDate { get; set; }
        public string? EndDate { get; set; }
        public Guid? CategoryId { get; set; }
        public Guid? PaymentChannelId { get; set; }
        public Guid? LedgerId { get; set; }
        public BillType? Type { get; set; }
    }

    private class BillModel
    {
        public Guid Id { get; set; }
        public decimal Amount { get; set; }
        public string Type { get; set; } = string.Empty;
        public Guid CategoryId { get; set; }
        public string CategoryName { get; set; } = string.Empty;
        public string CategoryIcon { get; set; } = string.Empty;
        public Guid PaymentChannelId { get; set; }
        public string PaymentChannelName { get; set; } = string.Empty;
        public string PaymentChannelIcon { get; set; } = string.Empty;
        public string? LedgerName { get; set; }
        public string? LedgerIcon { get; set; }
        public DateTime TransactionTime { get; set; }
        public string? Note { get; set; }
    }

    private class BillGroup
    {
        public DateTime Date { get; set; }
        public List<BillModel> Bills { get; set; } = new();
        public decimal TotalExpense { get; set; }
        public decimal TotalIncome { get; set; }
    }

    private class CategoryModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public BillType Type { get; set; }
    }

    private class PaymentChannelModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
    }

    private class LedgerModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public bool IsShared { get; set; }
    }

    /// <summary>
    /// 账本下拉显示文本：共享账本追加（共享）标记
    /// </summary>
    private string GetLedgerDisplayText(LedgerModel ledger) =>
        ledger.IsShared ? $"{ledger.Name}（共享）" : ledger.Name;
}
