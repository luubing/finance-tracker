@page "/trend"
@using FinanceTracker.Core.Interfaces
@using FinanceTracker.Core.Enums
@inject IStatisticsService StatisticsService
@inject IJSRuntime JSRuntime
@inject IPopupService PopupService

<PStackPageBar Title="趋势分析"
               CenterTitle
               Flat
               Color="primary" />

<MContainer Style="height: calc(100vh - 56px); overflow-y: scroll;">
    <!-- 筛选条件 -->
    <MRow>
        <MCol Cols="12">
            <MCard Class="mb-4">
                <MCardTitle>
                    <MIcon Class="mr-2">mdi-chart-line</MIcon>
                    趋势分析
                </MCardTitle>

                <MCardText>
                    <MRow>
                        <MCol Cols="12" Sm="6" Md="4">
                            <MSelect Value="_selectedRange"
                                     ValueChanged="@((StringNumber v) => OnRangeChanged(v))"
                                     Items="_timeRanges"
                                     ItemText="r => r.Text"
                                     ItemValue="r => r.Value"
                                     Label="时间范围"
                                     Outlined
                                     Dense
                                     HideDetails="true" />
                        </MCol>
                        <MCol Cols="12" Sm="6" Md="4">
                            <MButtonGroup Value="_selectedDimension">
                                <MButton Value="@("day")" OnClick="@(() => ChangeDimension("day"))">按日</MButton>
                                <MButton Value="@("week")" OnClick="@(() => ChangeDimension("week"))">按周</MButton>
                                <MButton Value="@("month")" OnClick="@(() => ChangeDimension("month"))">按月</MButton>
                            </MButtonGroup>
                        </MCol>
                    </MRow>
                </MCardText>
            </MCard>
        </MCol>
    </MRow>

    @if (_isLoading)
    {
        <MContainer Class="d-flex justify-center align-center" Style="height: 200px;">
            <MProgressCircular Indeterminate Size="64" Color="primary" />
        </MContainer>
    }
    else
    {
        <!-- 统计卡片 -->
        <MRow Dense Class="mb-0">
            <MCol Cols="4" Class="d-flex">
                <MCard Color="error" Dark Class="flex-grow-1">
                    <MCardText Class="text-center py-2">
                        <div class="text-caption">总支出</div>
                        <div class="text-subtitle-2 text-no-wrap">¥@_totalExpense.ToString("N2")</div>
                    </MCardText>
                </MCard>
            </MCol>
            <MCol Cols="4" Class="d-flex">
                <MCard Color="success" Dark Class="flex-grow-1">
                    <MCardText Class="text-center py-2">
                        <div class="text-caption">总收入</div>
                        <div class="text-subtitle-2 text-no-wrap">¥@_totalIncome.ToString("N2")</div>
                    </MCardText>
                </MCard>
            </MCol>
            <MCol Cols="4" Class="d-flex">
                <MCard Color="@(_totalNetIncome >= 0 ? "success" : "error")" Dark Class="flex-grow-1">
                    <MCardText Class="text-center py-2">
                        <div class="text-caption">净收支</div>
                        <div class="text-subtitle-2 text-no-wrap">¥@_totalNetIncome.ToString("N2")</div>
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>

        <!-- 趋势图表 -->
        <MRow Class="mb-0">
            <MCol Cols="12">
                <MCard>
                    <MCardTitle>
                        <MIcon Class="mr-2">mdi-chart-line</MIcon>
                        支出趋势
                    </MCardTitle>
                    <MCardText>
                        @if (_trendData.Any())
                        {
                            <MECharts Option="@_expenseLineOption" Height="300" />
                        }
                        else
                        {
                            <div class="text-center text--secondary py-4">暂无支出数据</div>
                        }
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>

        <MRow Class="mb-0">
            <MCol Cols="12">
                <MCard>
                    <MCardTitle>
                        <MIcon Class="mr-2">mdi-chart-line</MIcon>
                        收入趋势
                    </MCardTitle>
                    <MCardText>
                        @if (_trendData.Any())
                        {
                            <MECharts Option="@_incomeLineOption" Height="300" />
                        }
                        else
                        {
                            <div class="text-center text--secondary py-4">暂无收入数据</div>
                        }
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>

        <MRow Class="mb-0">
            <MCol Cols="12">
                <MCard>
                    <MCardTitle>
                        <MIcon Class="mr-2">mdi-chart-line</MIcon>
                        净收支趋势
                    </MCardTitle>
                    <MCardText>
                        @if (_trendData.Any())
                        {
                            <MECharts Option="@_netIncomeLineOption" Height="300" />
                        }
                        else
                        {
                            <div class="text-center text--secondary py-4">暂无数据</div>
                        }
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>

        <!-- 趋势数据表格 -->
        <MRow Class="pb-4">
            <MCol Cols="12">
                <MCard>
                    <MCardTitle>
                        <MIcon Class="mr-2">mdi-table</MIcon>
                        趋势数据明细
                    </MCardTitle>
                    <MCardText>
                        <MDataTable Headers="_tableHeaders"
                                    Items="_trendData"
                                    Dense
                                    Hover>
                            <ItemColContent>
                                @if (context.Header.Value == "date")
                                {
                                    @context.Item.Date.ToString("yyyy-MM-dd")
                                }
                                else if (context.Header.Value == "expense")
                                {
                                    <span class="error--text">¥@context.Item.Expense.ToString("N2")</span>
                                }
                                else if (context.Header.Value == "income")
                                {
                                    <span class="success--text">¥@context.Item.Income.ToString("N2")</span>
                                }
                                else if (context.Header.Value == "netIncome")
                                {
                                    <span class="@(context.Item.NetIncome >= 0 ? "success--text" : "error--text")">
                                        ¥@context.Item.NetIncome.ToString("N2")
                                    </span>
                                }
                            </ItemColContent>
                        </MDataTable>
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>
    }
</MContainer>

@code {
    private bool _isLoading = true;
    private string _selectedRange = "7days";
    private string _selectedDimension = "day";

    private List<TrendDataModel> _trendData = new();
    private object? _expenseLineOption;
    private object? _incomeLineOption;
    private object? _netIncomeLineOption;

    private decimal _totalExpense;
    private decimal _totalIncome;
    private decimal _totalNetIncome;

    private Guid _userId;

    private List<(string Text, string Value)> _timeRanges = new()
    {
        ("最近7天", "7days"),
        ("最近30天", "30days"),
        ("最近90天", "90days"),
        ("最近12个月", "12months")
    };

    private List<DataTableHeader<TrendDataModel>> _tableHeaders = new()
    {
        new() { Text = "日期", Value = "date", Sortable = true },
        new() { Text = "支出", Value = "expense", Sortable = true },
        new() { Text = "收入", Value = "income", Sortable = true },
        new() { Text = "净收支", Value = "netIncome", Sortable = true }
    };

    protected override async Task OnInitializedAsync()
    {
        var userIdStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
        if (!string.IsNullOrEmpty(userIdStr) && Guid.TryParse(userIdStr, out var userId))
        {
            _userId = userId;
        }

        await LoadTrendData();
    }

    private async Task LoadTrendData()
    {
        _isLoading = true;

        try
        {
            var (startDate, endDate) = GetDateRange(_selectedRange);

            var trendData = await StatisticsService.GetTrendDataAsync(_userId, startDate, endDate, _selectedDimension);

            _trendData = trendData.Select(t => new TrendDataModel
            {
                Date = t.Date,
                Expense = t.Expense,
                Income = t.Income,
                NetIncome = t.NetIncome
            }).ToList();

            _totalExpense = _trendData.Sum(t => t.Expense);
            _totalIncome = _trendData.Sum(t => t.Income);
            _totalNetIncome = _trendData.Sum(t => t.NetIncome);

            // 准备图表数据
            var dates = _trendData.Select(t => t.Date.ToString("MM-dd")).ToArray();

            _expenseLineOption = BuildLineOption("支出趋势", dates, _trendData.Select(t => t.Expense).ToArray());
            _incomeLineOption = BuildLineOption("收入趋势", dates, _trendData.Select(t => t.Income).ToArray());
            _netIncomeLineOption = BuildLineOption("净收支趋势", dates, _trendData.Select(t => t.NetIncome).ToArray());
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"加载失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private object BuildLineOption(string title, string[] dates, decimal[] values)
    {
        return new
        {
            title = new { text = title, left = "center" },
            tooltip = new { trigger = "axis" },
            legend = new { data = new[] { title }, bottom = "0" },
            xAxis = new
            {
                type = "category",
                data = dates,
                axisLabel = new { rotate = 45 }
            },
            yAxis = new { type = "value", axisLabel = new { formatter = "¥{value}" } },
            series = new[]
            {
                new
                {
                    name = title,
                    type = "line",
                    data = values.Select(v => (double)v).ToArray(),
                    smooth = true,
                    areaStyle = new { opacity = 0.3 },
                    itemStyle = new { color = title.Contains("支出") ? "#FF5252" : title.Contains("收入") ? "#4CAF50" : "#2196F3" }
                }
            }
        };
    }

    private (DateTime startDate, DateTime endDate) GetDateRange(string range)
    {
        var endDate = DateTime.Now;
        var startDate = range switch
        {
            "7days" => endDate.AddDays(-7),
            "30days" => endDate.AddDays(-30),
            "90days" => endDate.AddDays(-90),
            "12months" => endDate.AddMonths(-12),
            _ => endDate.AddDays(-7)
        };

        return (startDate, endDate);
    }

    private async Task OnRangeChanged(StringNumber value)
    {
        _selectedRange = value?.ToString() ?? "7days";
        await LoadTrendData();
    }

    private async Task ChangeDimension(string dimension)
    {
        _selectedDimension = dimension;
        await LoadTrendData();
    }

    private class TrendDataModel
    {
        public DateTime Date { get; set; }
        public decimal Expense { get; set; }
        public decimal Income { get; set; }
        public decimal NetIncome { get; set; }
    }
}
