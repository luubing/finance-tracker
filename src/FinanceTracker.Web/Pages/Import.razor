@page "/import"
@using FinanceTracker.Web.Services
@inject HttpService HttpService
@inject IPopupService PopupService
@inject NavigationManager Navigation

<MContainer>
    <MRow>
        <MCol Cols="12">
            <MCard>
                <MCardTitle>
                    <MIcon Class="mr-2">mdi-import</MIcon>
                    导入账单
                </MCardTitle>

                <MCardText>
                    <MRow>
                        <!-- 微信账单导入 -->
                        <MCol Cols="12" Md="6">
                            <MCard Outlined>
                                <MCardTitle>
                                    <MIcon Class="mr-2" Color="success">mdi-wechat</MIcon>
                                    微信账单导入
                                </MCardTitle>
                                <MCardText>
                                    <div class="text-body-2 mb-4">
                                        支持微信导出的 CSV 格式账单文件。
                                        <br />
                                        导出路径：微信 → 我 → 服务 → 钱包 → 账单 → 常见问题 → 下载账单
                                    </div>

                                    <MFileInput @bind-Value="_wechatFile"
                                                Label="选择微信账单文件"
                                                Accept=".csv"
                                                Outlined
                                                Dense
                                                ShowSize />

                                    <MButton Color="success"
                                             Block
                                             OnClick="ImportWeChat"
                                             Loading="_importingWechat"
                                             Disabled="_importingWechat || _wechatFile == null">
                                        <MIcon Class="mr-2">mdi-upload</MIcon>
                                        导入微信账单
                                    </MButton>
                                </MCardText>
                            </MCard>
                        </MCol>

                        <!-- 支付宝账单导入 -->
                        <MCol Cols="12" Md="6">
                            <MCard Outlined>
                                <MCardTitle>
                                    <MIcon Class="mr-2" Color="primary">mdi-alpha-a-circle</MIcon>
                                    支付宝账单导入
                                </MCardTitle>
                                <MCardText>
                                    <div class="text-body-2 mb-4">
                                        支持支付宝导出的 CSV 格式账单文件。
                                        <br />
                                        导出路径：支付宝 → 我的 → 账单 → 右上角 ··· → 开具交易流水证明
                                    </div>

                                    <MFileInput @bind-Value="_alipayFile"
                                                Label="选择支付宝账单文件"
                                                Accept=".csv"
                                                Outlined
                                                Dense
                                                ShowSize />

                                    <MButton Color="primary"
                                             Block
                                             OnClick="ImportAlipay"
                                             Loading="_importingAlipay"
                                             Disabled="_importingAlipay || _alipayFile == null">
                                        <MIcon Class="mr-2">mdi-upload</MIcon>
                                        导入支付宝账单
                                    </MButton>
                                </MCardText>
                            </MCard>
                        </MCol>
                    </MRow>

                    <!-- 导入结果 -->
                    @if (_importResult != null)
                    {
                        <MRow Class="mt-4">
                            <MCol Cols="12">
                                <MCard Color="@(_importResult.FailCount > 0 ? "warning" : "success")" Dark>
                                    <MCardText>
                                        <div class="text-h6 mb-2">导入完成</div>
                                        <div>总计: @_importResult.TotalCount 条</div>
                                        <div>成功: @_importResult.SuccessCount 条</div>
                                        @if (_importResult.FailCount > 0)
                                        {
                                            <div>失败: @_importResult.FailCount 条</div>
                                            @if (_importResult.Errors?.Any() == true)
                                            {
                                                <div class="mt-2">
                                                    <div class="text-subtitle-2">错误详情：</div>
                                                    @foreach (var error in _importResult.Errors)
                                                    {
                                                        <div class="text-caption">• @error</div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </MCardText>
                                </MCard>
                            </MCol>
                        </MRow>
                    }
                </MCardText>
            </MCard>
        </MCol>
    </MRow>
</MContainer>

@code {
    private IBrowserFile? _wechatFile;
    private IBrowserFile? _alipayFile;
    private bool _importingWechat;
    private bool _importingAlipay;
    private ImportResult? _importResult;

    private async Task ImportWeChat()
    {
        if (_wechatFile == null) return;

        _importingWechat = true;
        _importResult = null;

        try
        {
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(_wechatFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            content.Add(fileContent, "file", _wechatFile.Name);

            var httpClient = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
            var response = await httpClient.PostAsync("api/import/wechat", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();
                _importResult = System.Text.Json.JsonSerializer.Deserialize<ImportResult>(result, new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
                await PopupService.EnqueueSnackbarAsync("微信账单导入完成", AlertTypes.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await PopupService.EnqueueSnackbarAsync($"导入失败: {error}", AlertTypes.Error);
            }
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"导入失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _importingWechat = false;
        }
    }

    private async Task ImportAlipay()
    {
        if (_alipayFile == null) return;

        _importingAlipay = true;
        _importResult = null;

        try
        {
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(_alipayFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            content.Add(fileContent, "file", _alipayFile.Name);

            var httpClient = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
            var response = await httpClient.PostAsync("api/import/alipay", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();
                _importResult = System.Text.Json.JsonSerializer.Deserialize<ImportResult>(result, new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
                await PopupService.EnqueueSnackbarAsync("支付宝账单导入完成", AlertTypes.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await PopupService.EnqueueSnackbarAsync($"导入失败: {error}", AlertTypes.Error);
            }
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"导入失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _importingAlipay = false;
        }
    }

    private class ImportResult
    {
        public int TotalCount { get; set; }
        public int SuccessCount { get; set; }
        public int FailCount { get; set; }
        public List<string>? Errors { get; set; }
    }
}
