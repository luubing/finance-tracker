@page "/add-bill"
@page "/add-bill/{BillId}"
@using FinanceTracker.Core.Enums
@using FinanceTracker.Core.Interfaces
@using FinanceTracker.Core.Services
@using FinanceTracker.Web.Services
@inject IBillService BillService
@inject ICategoryService CategoryService
@inject IPaymentChannelService PaymentChannelService
@inject ILedgerService LedgerService
@inject ISpeechService SpeechService
@inject IBillVoiceParser VoiceParser
@inject BillVoiceInputService VoiceInputService
@inject AuthenticationService AuthStateService
@inject IJSRuntime JSRuntime
@inject PageStackNavController NavController
@inject IPopupService PopupService
@inject BillEventService BillEventService
@implements IDisposable

<PStackPageBar Title="@(IsEditing ? "编辑账单" : "记一笔")"
               CenterTitle
               Flat
               Color="primary" />

<MContainer Style="height: calc(100vh - 56px); overflow-y: scroll;">
    <MRow>
        <MCol Cols="12">
            <MCard>
                <MCardText>
                    <!-- 语音录入：识别结果仅预填表单，确认后保存 -->
                    <div class="voice-bar d-flex align-center mb-4">
                        <MIcon Class="mr-2" Color="@(_voiceBrowserSupported ? "primary" : "grey")">mdi-microphone</MIcon>
                        <div class="flex-grow-1 text-body-2 text--secondary">
                            @(_voiceStatus ?? "点击麦克风说出账单，例如：昨天午饭花了三十五块，微信支付")
                        </div>
                        <MButton Color="primary"
                                 Small
                                 Dark
                                 Class="ml-2"
                                 Loading="@(_voicePhase == BillVoiceInputPhase.Listening)"
                                 Disabled="@(!_voiceBrowserSupported || _voicePhase != BillVoiceInputPhase.Idle)"
                                 OnClick="StartVoiceInput">
                            <MIcon Small>mdi-microphone</MIcon>
                        </MButton>
                    </div>
                    @if (_voiceMatchHint != null)
                    {
                        <div class="voice-matched-hint">@_voiceMatchHint</div>
                    }

                    <MForm @ref="_form" Model="_model" OnValidSubmit="SaveBill">
                        <!-- 支出/收入切换 -->
                        <MRow>
                            <MCol Cols="12">
                                <MButtonGroup Value="_model.Type.ToString()" ValueChanged="OnTypeChanged">
                                    <MButton Value="@("Expense")" Color="@(_model.Type == BillType.Expense ? "error" : "default")">
                                        <MIcon Class="mr-2">mdi-minus-circle</MIcon>
                                        支出
                                    </MButton>
                                    <MButton Value="@("Income")" Color="@(_model.Type == BillType.Income ? "success" : "default")">
                                        <MIcon Class="mr-2">mdi-plus-circle</MIcon>
                                        收入
                                    </MButton>
                                </MButtonGroup>
                            </MCol>
                        </MRow>

                        <!-- 金额输入 -->
                        <MRow>
                            <MCol Cols="12">
                                <MTextField @bind-Value="_model.Amount"
                                            Label="金额"
                                            Outlined
                                            Dense
                                            Type="number"
                                            Prefix="¥"
                                            Required
                                            HideDetails="true"
                                            NumberProps="@(prop => { prop.Min = 0; prop.Step = 0.01m; })"
                                            Rules="_amountRules"
                                            OnBlur="OnAmountBlur" />
                            </MCol>
                        </MRow>

                        <!-- 分类选择 -->
                        <MRow>
                            <MCol Cols="12">
                                <div class="text-subtitle-2 mb-2">选择分类</div>
                                <MCard Outlined Class="category-card">
                                    <MCardText Class="pa-2">
                                        <div class="category-grid">
                                            @foreach (var category in _categories.Where(c => c.Type == _model.Type))
                                            {
                                                <MButton Class="@(_model.CategoryId == category.Id ? "category-btn selected-category" : "category-btn")"
                                                         Outlined
                                                         Small
                                                         OnClick="() => _model.CategoryId = category.Id">
                                                    <MIcon Small Class="mr-1">@category.Icon</MIcon>
                                                    <span class="text-caption">@category.Name</span>
                                                </MButton>
                                            }
                                        </div>
                                    </MCardText>
                                </MCard>
                            </MCol>
                        </MRow>

                        <!-- 支付渠道选择 -->
                        <MRow>
                            <MCol Cols="12">
                                <MSelect @bind-Value="_model.PaymentChannelId"
                                         Items="_paymentChannels"
                                         ItemText="c => c.Name"
                                         ItemValue="c => c.Id"
                                         Label="支付渠道"
                                         Outlined
                                         Dense
                                         Required
                                         HideDetails="true">
                                    <SelectionContent Context="item">
                                        <MIcon Class="mr-2">@(item.Item?.Icon ?? "mdi-credit-card")</MIcon>
                                        @(item.Item?.Name ?? "未知渠道")
                                    </SelectionContent>
                                </MSelect>
                            </MCol>
                        </MRow>

                        <!-- 账本选择 -->
                        <MRow>
                            <MCol Cols="12">
                                <MSelect @bind-Value="_model.LedgerId"
                                         Items="_ledgers"
                                         ItemText="l => l.Name"
                                         ItemValue="l => (Guid?)l.Id"
                                         Label="账本（可选）"
                                         Outlined
                                         Dense
                                         Clearable
                                         HideDetails="true">
                                    <SelectionContent Context="item">
                                        <MIcon Class="mr-2">@(item.Item?.Icon ?? "mdi-book")</MIcon>
                                        @(item.Item?.Name ?? "不归属账本")
                                    </SelectionContent>
                                </MSelect>
                            </MCol>
                        </MRow>

                        <!-- 交易时间 -->
                        <MRow>
                            <MCol Cols="12">
                                <MTextField @bind-Value="_model.TransactionTime"
                                            Label="交易时间"
                                            Outlined
                                            Dense
                                            HideDetails="true"
                                            Type="datetime-local" />
                            </MCol>
                        </MRow>

                        <!-- 备注 -->
                        <MRow>
                            <MCol Cols="12">
                                <MTextarea @bind-Value="_model.Note"
                                           Label="备注（可选）"
                                           Outlined
                                           Dense
                                           AutoGrow
                                           Rows="2"
                                           Placeholder="添加备注..."
                                           HideDetails="true" />
                            </MCol>
                        </MRow>

                        <!-- 提交按钮 -->
                        <MRow>
                            <MCol Cols="12">
                                <MButton Type="submit"
                                         Color="primary"
                                         Block
                                         Large
                                         Loading="_loading"
                                         Disabled="_loading">
                                    @(IsEditing ? "保存修改" : "保存")
                                </MButton>
                            </MCol>
                        </MRow>
                    </MForm>
                </MCardText>
            </MCard>
        </MCol>
    </MRow>
</MContainer>

<style>
    .category-card {
        max-height: 200px;
        overflow-y: auto;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .category-btn {
        min-width: 0 !important;
        padding: 8px 4px !important;
        text-transform: none !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .selected-category {
        background-color: #1976D2 !important;
        color: white !important;
        border-color: #1976D2 !important;
        box-shadow: 0 2px 8px rgba(25, 118, 210, 0.4);
    }

    .selected-category .m-icon {
        color: white !important;
    }

    .voice-bar {
        background: #F5F7FA;
        border-radius: 8px;
        padding: 10px 12px;
    }

    .voice-matched-hint {
        font-size: 12px;
        color: #4CAF50;
        margin-top: 4px;
    }
</style>

@code {
    [Parameter]
    public string? BillId { get; set; }

    // ===== 语音录入状态 =====

    /// <summary>语音录入交互阶段（禁止在待办/识别中重复触发）</summary>
    private enum BillVoiceInputPhase
    {
        Idle = 0,
        Listening = 1,
        Parsing = 2
    }

    /// <summary>语音栏提示文案（null 显示默认引导语）</summary>
    private string? _voiceStatus;

    /// <summary>当前交互阶段</summary>
    private BillVoiceInputPhase _voicePhase = BillVoiceInputPhase.Idle;

    /// <summary>浏览器 Web Speech API 是否可用（决定麦克风按钮是否可点）</summary>
    private bool _voiceBrowserSupported;

    /// <summary>本次表单是否由语音预填（保存时据此标记数据来源）</summary>
    private bool _voicePrefilled;

    /// <summary>语音解析命中的分类/渠道提示</summary>
    private string? _voiceMatchHint;

    /// <summary>语音识别取消令牌来源（识别超时控制）</summary>
    private CancellationTokenSource? _voiceCts;

    /// <summary>语音能力初始化标记（OnAfterRenderAsync 只执行一次）</summary>
    private bool _voiceInitialized;

    private bool IsEditing => !string.IsNullOrEmpty(BillId);

    private MForm? _form;
    private BillModel _model = new();
    private List<CategoryModel> _categories = new();
    private List<PaymentChannelModel> _paymentChannels = new();
    private List<LedgerModel> _ledgers = new();
    private bool _loading;
    private Guid _userId;

    private List<Func<decimal, StringBoolean>> _amountRules = new()
    {
        v => v > 0 ? true : "金额必须大于0",
        v => decimal.Round(v, 2) == v ? true : "最多保留两位小数"
    };

    private void OnAmountBlur(FocusEventArgs e)
    {
        _model.Amount = decimal.Round(_model.Amount, 2);
    }

    protected override async Task OnInitializedAsync()
    {
        // 优先使用认证服务的缓存用户 ID（同一电路内可靠），localStorage 作为兜底
        var userId = await AuthStateService.GetUserIdAsync();
        if (userId.HasValue)
        {
            _userId = userId.Value;
        }

        await LoadData();

        if (IsEditing && Guid.TryParse(BillId, out var billId))
        {
            await LoadBill(billId);
        }
        else
        {
            _model.TransactionTime = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 语音能力检测依赖 JS interop，必须放在渲染完成后执行：
        // 预渲染阶段 IJSRuntime 不可用，若在 OnInitializedAsync 中调用会导致电路终止
        // （与 AuthenticationService.IsPrerendering 处理的是同类问题）
        if (!firstRender || _voiceInitialized)
        {
            return;
        }

        _voiceInitialized = true;

        // MAUI 宿主注册原生语音服务；Blazor Server 注入的是 NoOpSpeechService（无原生能力），
        // 此时检测浏览器 Web Speech API 是否可用，决定麦克风按钮是否可点
        VoiceInputService.RegisterVoiceService(SpeechService);
        if (!VoiceInputService.IsUsingNativeVoice)
        {
            try
            {
                _voiceBrowserSupported = await VoiceInputService.IsBrowserSupportedAsync();
            }
            catch (Exception)
            {
                // JS 模块加载失败（如宿主不支持）一律按不支持处理，静默降级为手动录入
                _voiceBrowserSupported = false;
            }
        }
        else
        {
            _voiceBrowserSupported = true;
        }

        if (_voiceBrowserSupported)
        {
            VoiceInputService.VoiceTextReceived += OnVoiceTextReceived;
            VoiceInputService.ErrorOccurred += OnVoiceErrorOccurred;
        }
        else
        {
            _voiceStatus = "当前环境不支持语音识别，可手动填写账单";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadData()
    {
        var categories = await CategoryService.GetCategoriesAsync(_userId);
        _categories = categories.Select(c => new CategoryModel
        {
            Id = c.Id,
            Name = c.Name,
            Icon = c.Icon,
            Type = c.Type
        }).ToList();

        var channels = await PaymentChannelService.GetPaymentChannelsAsync(_userId);
        _paymentChannels = channels.Select(c => new PaymentChannelModel
        {
            Id = c.Id,
            Name = c.Name,
            Icon = c.Icon
        }).ToList();

        var ledgers = await LedgerService.GetLedgersAsync(_userId);
        _ledgers = ledgers.Select(l => new LedgerModel
        {
            Id = l.Id,
            Name = l.Name,
            Icon = l.Icon
        }).ToList();
    }

    private async Task LoadBill(Guid billId)
    {
        var bill = await BillService.GetBillByIdAsync(billId);
        if (bill != null && bill.UserId == _userId)
        {
            _model = new BillModel
            {
                Amount = bill.Amount,
                Type = bill.Type,
                CategoryId = bill.CategoryId,
                PaymentChannelId = bill.PaymentChannelId,
                LedgerId = bill.LedgerId,
                TransactionTime = bill.TransactionTime.ToString("yyyy-MM-ddTHH:mm"),
                Note = bill.Note
            };
        }
        else
        {
            await PopupService.EnqueueSnackbarAsync("账单不存在", AlertTypes.Warning);
            NavController.Pop();
        }
    }

    private void OnTypeChanged(StringNumber value)
    {
        if (value?.ToString() == "Income")
        {
            _model.Type = BillType.Income;
        }
        else
        {
            _model.Type = BillType.Expense;
        }
        _model.CategoryId = Guid.Empty;
    }

    private async Task SaveBill()
    {
        if (_loading) return;

        if (_userId == Guid.Empty)
        {
            await PopupService.EnqueueSnackbarAsync("请先登录", AlertTypes.Warning);
            NavController.Push("/login");
            return;
        }

        if (_model.CategoryId == Guid.Empty)
        {
            await PopupService.EnqueueSnackbarAsync("请选择分类", AlertTypes.Warning);
            return;
        }

        if (_model.PaymentChannelId == Guid.Empty)
        {
            await PopupService.EnqueueSnackbarAsync("请选择支付渠道", AlertTypes.Warning);
            return;
        }

        _loading = true;

        try
        {
            var transactionTime = DateTime.TryParse(_model.TransactionTime, out var time) ? time : DateTime.UtcNow;

            if (IsEditing && Guid.TryParse(BillId, out var billId))
            {
                var bill = new Core.Entities.Bill
                {
                    Id = billId,
                    UserId = _userId,
                    Amount = _model.Amount,
                    Type = _model.Type,
                    CategoryId = _model.CategoryId,
                    PaymentChannelId = _model.PaymentChannelId,
                    LedgerId = _model.LedgerId,
                    TransactionTime = transactionTime,
                    Note = _model.Note
                };

                await BillService.UpdateBillAsync(bill);
                await PopupService.EnqueueSnackbarAsync("账单更新成功", AlertTypes.Success);
            }
            else
            {
                var bill = new Core.Entities.Bill
                {
                    UserId = _userId,
                    Amount = _model.Amount,
                    Type = _model.Type,
                    CategoryId = _model.CategoryId,
                    PaymentChannelId = _model.PaymentChannelId,
                    LedgerId = _model.LedgerId,
                    TransactionTime = transactionTime,
                    Note = _model.Note,
                    // 语音预填的账单标记来源为语音识别，便于后续统计分析
                    Source = _voicePrefilled ? BillSource.Voice : BillSource.Manual
                };

                await BillService.CreateBillAsync(bill);
                await PopupService.EnqueueSnackbarAsync("账单创建成功", AlertTypes.Success);
            }

            BillEventService.NotifyBillChanged();
            NavController.Pop();
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"保存失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoBack()
    {
        NavController.Pop();
    }

    // ===== 语音录入 =====

    /// <summary>点击麦克风：启动一次语音识别</summary>
    private async Task StartVoiceInput()
    {
        if (_voicePhase != BillVoiceInputPhase.Idle || !_voiceBrowserSupported)
        {
            return;
        }

        _voicePhase = BillVoiceInputPhase.Listening;
        _voiceStatus = "正在聆听，请说出账单内容…";
        _voiceMatchHint = null;
        StateHasChanged();

        // 识别最长 15 秒，避免 SpeechRecognizer 异常挂起导致按钮永远转圈
        _voiceCts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
        try
        {
            await VoiceInputService.StartAsync(_voiceCts.Token);
        }
        finally
        {
            _voiceCts.Dispose();
            _voiceCts = null;
            if (_voicePhase == BillVoiceInputPhase.Listening)
            {
                // 识别结束但未收到文本（如静默超时），恢复正常状态
                _voicePhase = BillVoiceInputPhase.Idle;
                _voiceStatus = null;
                StateHasChanged();
            }
        }
    }

    /// <summary>语音识别完成：解析文本并预填表单（不直接保存，由用户确认）</summary>
    private async Task OnVoiceTextReceived(string text)
    {
        _voicePhase = BillVoiceInputPhase.Parsing;
        _voiceStatus = $"识别到「{text}」，正在解析…";
        await InvokeAsync(StateHasChanged);

        try
        {
            var draft = await VoiceParser.ParseAsync(text, _categories.Select(c => new Category
            {
                Id = c.Id,
                Name = c.Name,
                Type = c.Type
            }).ToList(), _paymentChannels.Select(p => new PaymentChannel
            {
                Id = p.Id,
                Name = p.Name
            }).ToList());

            ApplyVoiceDraft(draft);

            if (!draft.Amount.HasValue)
            {
                // 关键字段缺失时不修改表单，提示用户重试
                _voiceStatus = null;
                await PopupService.EnqueueSnackbarAsync("未能识别金额，请说出金额后重试，例如：昨天午饭花了三十五块", AlertTypes.Warning);
                return;
            }

            _voicePrefilled = true;
            _voiceStatus = $"已按「{text}」预填账单，请确认后保存";
        }
        catch (Exception ex)
        {
            _voiceStatus = null;
            await PopupService.EnqueueSnackbarAsync($"解析语音内容失败：{ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _voicePhase = BillVoiceInputPhase.Idle;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>语音识别失败：恢复状态并提示</summary>
    private async Task OnVoiceErrorOccurred(string message)
    {
        _voicePhase = BillVoiceInputPhase.Idle;
        _voiceStatus = null;
        await InvokeAsync(StateHasChanged);
        await PopupService.EnqueueSnackbarAsync(message, AlertTypes.Error);
    }

    /// <summary>
    /// 将解析结果预填到表单：只填识别到的字段，未识别字段保持原值由用户手动补充。
    /// 分类/渠道必须在当前候选列表中（且类型匹配）才会应用。
    /// </summary>
    private void ApplyVoiceDraft(ParsedBillDraft draft)
    {
        var applied = new List<string>();

        if (draft.Amount is decimal amount && amount > 0)
        {
            _model.Amount = decimal.Round(amount, 2);
            applied.Add("金额");
        }

        if (draft.Type != _model.Type)
        {
            _model.Type = draft.Type;
            _model.CategoryId = Guid.Empty; // 类型切换后原分类可能不适用
        }

        if (draft.CategoryId is Guid categoryId &&
            _categories.Any(c => c.Id == categoryId && c.Type == _model.Type))
        {
            _model.CategoryId = categoryId;
            var categoryName = _categories.First(c => c.Id == categoryId).Name;
            applied.Add($"分类「{categoryName}」");
        }

        if (draft.PaymentChannelId is Guid channelId &&
            _paymentChannels.Any(p => p.Id == channelId))
        {
            _model.PaymentChannelId = channelId;
            var channelName = _paymentChannels.First(p => p.Id == channelId).Name;
            applied.Add($"支付渠道「{channelName}」");
        }

        if (draft.TransactionTime is DateTime time)
        {
            _model.TransactionTime = time.ToString("yyyy-MM-ddTHH:mm");
            applied.Add("交易时间");
        }

        if (!string.IsNullOrWhiteSpace(draft.RawText))
        {
            _model.Note = draft.RawText;
        }

        _voiceMatchHint = applied.Count > 0 ? $"已识别：{string.Join("、", applied)}" : null;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        VoiceInputService.VoiceTextReceived -= OnVoiceTextReceived;
        VoiceInputService.ErrorOccurred -= OnVoiceErrorOccurred;
        _voiceCts?.Dispose();
    }

    private class BillModel
    {
        public decimal Amount { get; set; }
        public BillType Type { get; set; } = BillType.Expense;
        public Guid CategoryId { get; set; }
        public Guid PaymentChannelId { get; set; }
        public Guid? LedgerId { get; set; }
        public string TransactionTime { get; set; } = string.Empty;
        public string? Note { get; set; }
    }

    private class CategoryModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public BillType Type { get; set; }
    }

    private class PaymentChannelModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
    }

    private class LedgerModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
    }
}
