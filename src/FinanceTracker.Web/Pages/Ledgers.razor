@page "/ledgers"
@using Masa.Blazor.Presets.PageStack.NavController
@implements IDisposable
@inject ILedgerService LedgerService
@inject ILedgerMemberService LedgerMemberService
@inject IUserDefaultService UserDefaultService
@inject IBillService BillService
@inject PageDataGate DataGate
@inject AuthenticationService AuthStateService
@inject IJSRuntime JSRuntime
@inject PageStackNavController NavController
@inject IPopupService PopupService
@inject ILogger<Ledgers> Logger

@*
    账本管理（二级页面模板的首个落地页，设计稿 05 / screens 08-ledgers）：
      · 共享账本邀请卡（接受 / 拒绝）
      · 我的账本：「默认」「共享」徽标；左滑出现「共享」「删除」；点按整行进入编辑 Sheet（含设为默认、共享、删除——左滑操作的非滑动等价入口）
      · 加入的共享账本：角色徽标；点按进入成员页
    右上角「＋」新建（底部 Sheet）；删除用 Alert 确认；提示走全局 Toast（PopupService 调用方式不变）。
    服务层校验与权限语义不变：本页只调用既有服务，不绕过任何校验。
*@

<SecondaryPage Title="账本" TestId="ledgers-page">
    <Actions>
        <GlassButton Kind="ButtonKind.Brand" Round Icon="mdi-plus" AriaLabel="新建账本" TestId="ledger-add" OnClick="OpenCreate" />
    </Actions>
    <ChildContent>
        @if (_isLoading)
        {
            <GroupedList Header="我的账本" TestId="ledgers-skeleton">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="ft-skeleton-row" aria-hidden="true">
                        <span class="ft-skeleton ft-skeleton--tile"></span>
                        <span class="ft-skeleton-row__main">
                            <span class="ft-skeleton ft-skeleton--title"></span>
                            <span class="ft-skeleton ft-skeleton--sub"></span>
                        </span>
                    </div>
                }
            </GroupedList>
        }
        else
        {
            @* 待处理邀请：每个邀请一张卡 *@
            @foreach (var invitation in _invitations)
            {
                <section class="ft-card ft-group" data-testid="invitation-card" aria-label="共享账本邀请">
                    <div class="ft-card__head">
                        <span class="ft-tile ft-tile--pink" aria-hidden="true"><i class="mdi mdi-account-plus"></i></span>
                        <div class="ft-card__titles">
                            <h2 class="ft-card__title" data-testid="invitation-title">@LedgerPresentation.InvitationTitle(invitation.LedgerName)</h2>
                            <p class="ft-card__subtitle" data-testid="invitation-subtitle">@LedgerPresentation.InvitationSubtitle(invitation.InviterPhoneNumber, invitation.Role)</p>
                        </div>
                    </div>
                    <div class="ft-btn-row">
                        <GlassButton Kind="ButtonKind.Neutral" Large TestId="invitation-reject" Disabled="@(_respondingId is not null)" OnClick="() => RespondInvitation(invitation, false)">拒绝</GlassButton>
                        <GlassButton Kind="ButtonKind.Brand" Large TestId="invitation-accept" Busy="@(_respondingId == invitation.MemberId)" Disabled="@(_respondingId is not null)" OnClick="() => RespondInvitation(invitation, true)">接受邀请</GlassButton>
                    </div>
                </section>
            }

            @* 我的账本 *@
            @if (_owned.Count > 0)
            {
                <GroupedList Header="我的账本" Footer="左滑账本可共享或删除，点按可编辑、设为默认。共享账本以云端为准，邀请需对方确认后生效。" TestId="own-ledgers">
                    @foreach (var ledger in _owned)
                    {
                        <SwipeRow TestId="ledger-row" data-ledger-id="@ledger.Id">
                            <Actions>
                                <SwipeAction Icon="mdi-share-variant" Label="共享" Tone="ActionTone.Brand" TestId="swipe-share" OnClick="() => OpenShare(ledger)" />
                                <SwipeAction Icon="mdi-delete" Label="删除" Tone="ActionTone.Danger" TestId="swipe-delete" OnClick="() => AskDelete(ledger)" />
                            </Actions>
                            <ChildContent>
                                <ListCell Icon="@LedgerPresentation.NormalizeIcon(ledger.Icon)"
                                          Tone="@LedgerPresentation.ToneFor(ledger.Id)"
                                          Title="@ledger.Name"
                                          Subtitle="@LedgerPresentation.OwnedSubtitle(ledger.BillCount, ledger.MemberCount)"
                                          Chevron
                                          TestId="ledger-cell"
                                          OnClick="() => OpenEdit(ledger)">
                                    <Badges>
                                        @if (ledger.IsDefault)
                                        {
                                            <Badge Kind="BadgeKind.Brand" TestId="badge-default">默认</Badge>
                                        }
                                        @if (ledger.MemberCount >= 2)
                                        {
                                            <Badge Kind="BadgeKind.Brand" TestId="badge-shared">共享</Badge>
                                        }
                                    </Badges>
                                </ListCell>
                            </ChildContent>
                        </SwipeRow>
                    }
                </GroupedList>
            }
            else if (_invitations.Count == 0 && _joined.Count == 0)
            {
                <EmptyState Icon="mdi-book-outline" Title="还没有账本" Text="账单必须记在某个账本里，先新建一个吧" TestId="ledgers-empty">
                    <Action>
                        <GlassButton Kind="ButtonKind.Brand" Large Icon="mdi-plus" TestId="ledger-empty-add" OnClick="OpenCreate">新建账本</GlassButton>
                    </Action>
                </EmptyState>
            }
            else
            {
                <GroupedList Header="我的账本" TestId="own-ledgers">
                    <ListCell Icon="mdi-book-outline" Title="暂无自己的账本" Subtitle="点右上角「＋」新建" />
                </GroupedList>
            }

            @* 加入的共享账本 *@
            @if (_joined.Count > 0)
            {
                <GroupedList Header="加入的共享账本" TestId="joined-ledgers">
                    @foreach (var shared in _joined)
                    {
                        <ListCell Icon="@LedgerPresentation.NormalizeIcon(shared.Icon)"
                                  Tone="@LedgerPresentation.ToneFor(shared.Id)"
                                  Title="@shared.Name"
                                  Subtitle="@LedgerPresentation.JoinedSubtitle(shared.OwnerPhoneNumber)"
                                  Chevron
                                  TestId="joined-cell"
                                  OnClick="() => NavigateToMembers(shared.Id)">
                            <Badges>
                                <Badge Kind="@(shared.Role == LedgerMemberRole.Viewer ? BadgeKind.Neutral : BadgeKind.Brand)" TestId="badge-role">@LedgerPresentation.RoleLabel(shared.Role)</Badge>
                            </Badges>
                        </ListCell>
                    }
                </GroupedList>
            }
        }
    </ChildContent>
</SecondaryPage>

@* 新建 / 编辑账本（底部 Sheet，表单本身在 LedgerFormSheet，首页的「新建账本」引导共用；编辑时的默认 / 共享 / 删除是本页自己的操作，放进插槽） *@
<LedgerFormSheet @bind-Visible="_sheetVisible"
                 UserId="_userId"
                 Editing="FormTarget"
                 OnSaved="OnLedgerSavedAsync"
                 OnClosed="OnSheetClosed">
    <EditingExtras>
        @if (_editing is { } editing)
        {
            <GroupedList>
                <ListCell Icon="mdi-star" Tone="orange" Title="设为默认账本" Subtitle="新建账单时默认记入这个账本">
                    <Trailing>
                        <ToggleSwitch Value="@editing.IsDefault" ValueChanged="OnDefaultToggled" AriaLabel="设为默认账本" TestId="ledger-default-switch" />
                    </Trailing>
                </ListCell>
                <ListCell Icon="mdi-share-variant" Tone="blue" Title="共享账本" Subtitle="邀请家人或朋友一起记账" Chevron TestId="ledger-share-cell" OnClick="() => OpenShare(editing)" />
            </GroupedList>

            <GroupedList>
                <ListCell Title="删除账本" Destructive TestId="ledger-delete-cell" OnClick="() => AskDelete(editing)" />
            </GroupedList>
        }
    </EditingExtras>
</LedgerFormSheet>

@* 删除确认 *@
<GlassAlert @bind-Visible="_deleteVisible"
            Title="@($"删除账本「{_deleteTarget?.Name}」？")"
            Message="删除后该账本不再显示。账本下还有账单时无法删除，请先把账单移到其他账本。"
            ConfirmText="删除"
            Destructive
            OnConfirm="DeleteConfirmedAsync"
            OnClosed="OnDeleteClosed"
            TestId="ledger-delete-alert" />

@* 共享账本：邀请成员 / 复制账本信息（左滑「共享」与编辑 Sheet 里的「共享账本」共用） *@
<ActionSheet @bind-Visible="_shareVisible"
             Title="@($"共享账本「{_shareTarget?.Name}」")"
             Message="邀请对方成为共享成员并确认后，即可共同记账、合并查看账单。"
             OnClosed="OnShareClosed"
             TestId="ledger-share-sheet">
    <ActionSheetItem Icon="mdi-account-plus" TestId="share-invite" OnClick="InviteFromShare">邀请成员共享</ActionSheetItem>
    <ActionSheetItem Icon="mdi-content-copy" TestId="share-copy" OnClick="CopyShareInfoAsync">复制账本信息</ActionSheetItem>
</ActionSheet>

@code {
    /// <summary>「我的账本」一行（取数时一次性算好，渲染时不再查库）</summary>
    private sealed record OwnedLedgerRow(Guid Id, string Name, string Icon, int SortOrder, bool IsDefault, int BillCount, int MemberCount);

    /// <summary>「加入的共享账本」一行</summary>
    private sealed record JoinedLedgerRow(Guid Id, string Name, string Icon, LedgerMemberRole Role, string? OwnerPhoneNumber);

    /// <summary>待处理邀请一张卡</summary>
    private sealed record InvitationRow(Guid MemberId, string? LedgerName, string? InviterPhoneNumber, LedgerMemberRole Role);

    private List<OwnedLedgerRow> _owned = new();
    private List<JoinedLedgerRow> _joined = new();
    private List<InvitationRow> _invitations = new();

    private Guid _userId;
    private bool _isLoading = true;
    private bool _disposed;
    private Guid? _respondingId;

    // 新建 / 编辑 Sheet（表单状态在 LedgerFormSheet 里；这里只记「是否显示」与「正在编辑哪一个」）
    private bool _sheetVisible;
    private OwnedLedgerRow? _editing;

    // 删除确认 Alert 与共享操作菜单
    private bool _deleteVisible;
    private OwnedLedgerRow? _deleteTarget;
    private bool _shareVisible;
    private OwnedLedgerRow? _shareTarget;

    protected override void OnInitialized()
    {
        // 从成员页返回时刷新成员数 / 共享状态（成员页里可能邀请、移除、转让了所有权）
        NavController.PageClosed += OnPageClosed;
    }

    // 注意：本应用为 Blazor Server（ServerPrerendered 渲染），OnInitializedAsync 阶段 JS interop
    // 不可用，直接读 localStorage.userId 会抛 "JavaScript interop calls cannot be issued at this
    // time" 异常，导致首次进入页面时列表加载中断（显示为空，交互后才有数据）。
    // 与 Index.razor 的既有修复保持一致，把依赖 JS 的初始化移到 OnAfterRenderAsync 首次渲染后执行。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadUserIdAsync();
        await LoadOwnedAsync();

        // 先渲染本地账本列表，再加载共享数据（云端不可用时不应阻塞列表展示）
        _isLoading = false;
        StateHasChanged();

        await LoadSharedDataAsync();
        StateHasChanged();
    }

    private async Task LoadUserIdAsync()
    {
        // AuthenticationService 带电路级缓存，且对预渲染/电路断开做了安全封装（失败返回 null，保持 Guid.Empty）
        _userId = await AuthStateService.GetUserIdAsync() ?? Guid.Empty;
    }

    private async Task LoadOwnedAsync()
    {
        try
        {
            // 只读本地库（成员数读的是本地缓存），整段排进页面数据闸门：别的 Tab 根页面可能正在后台重新加载，同一个 DbContext 不允许并行执行
            _owned = await DataGate.RunAsync(async () =>
            {
                var ledgers = await LedgerService.GetLedgersAsync(_userId);
                var userDefault = await UserDefaultService.GetUserDefaultAsync(_userId);
                var memberCounts = await LedgerMemberService.GetActiveMemberCountsAsync(_userId, ledgers.Select(l => l.Id).ToList());

                var rows = new List<OwnedLedgerRow>(ledgers.Count);
                foreach (var ledger in ledgers)
                {
                    // 同一个 DbContext 不支持并行查询，逐个账本统计账单数
                    var billCount = await BillService.GetBillCountAsync(_userId, ledgerId: ledger.Id);
                    rows.Add(new OwnedLedgerRow(
                        ledger.Id,
                        ledger.Name,
                        ledger.Icon,
                        ledger.SortOrder,
                        userDefault?.DefaultLedgerId == ledger.Id,
                        billCount,
                        memberCounts.GetValueOrDefault(ledger.Id)));
                }

                return rows;
            });
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"加载账本失败: {ex.GetUserMessage()}", AlertTypes.Error);
        }
    }

    /// <summary>
    /// 加载共享账本与待处理邀请（云端刷新 + 本地缓存；失败时回退本地缓存），随后按刷新后的成员关系更新「我的账本」的成员数。
    /// 整段排进页面数据闸门（同一个 DbContext 不允许并行执行）；联网刷新只有 3 秒上限、失败后 30 秒内直接读本地缓存，所以持有闸门的时间有界
    /// （与记一笔 Sheet / 账单筛选读共享账本同一做法）。
    /// </summary>
    private Task LoadSharedDataAsync() => DataGate.RunAsync(LoadSharedDataCoreAsync);

    /// <summary>闸门里的实际加载：里面不能再进闸门（不可重入），成员数用不带闸门的 <see cref="RefreshMemberCountsCoreAsync"/></summary>
    private async Task LoadSharedDataCoreAsync()
    {
        try
        {
            var ledgers = await LedgerMemberService.GetSharedLedgersAsync(_userId);

            var joined = new List<JoinedLedgerRow>(ledgers.Count);
            foreach (var ledger in ledgers)
            {
                var role = await LedgerMemberService.GetMyRoleAsync(ledger.Id, _userId);
                joined.Add(new JoinedLedgerRow(
                    ledger.Id,
                    ledger.Name,
                    ledger.Icon,
                    role ?? LedgerMemberRole.Viewer,
                    ledger.User?.PhoneNumber));
            }

            _joined = joined;
        }
        catch (Exception ex)
        {
            // 云端不可用时回退本地缓存
            await PopupService.EnqueueSnackbarAsync($"共享账本加载失败: {ex.GetUserMessage()}", AlertTypes.Warning);
        }

        try
        {
            _invitations = (await LedgerMemberService.GetPendingInvitationsAsync(_userId))
                .Select(m => new InvitationRow(m.Id, m.Ledger?.Name, m.Ledger?.User?.PhoneNumber, m.Role))
                .ToList();
        }
        catch
        {
            _invitations = new List<InvitationRow>();
        }

        await RefreshMemberCountsCoreAsync();
    }

    /// <summary>
    /// 成员关系刷新后重算「我的账本」的成员数（只读本地缓存，不联网），经页面数据闸门
    /// </summary>
    private Task RefreshMemberCountsAsync() => DataGate.RunAsync(RefreshMemberCountsCoreAsync);

    /// <summary>不带闸门的成员数重算：只能在已经持有闸门的 <see cref="LoadSharedDataCoreAsync"/> 里调用</summary>
    private async Task RefreshMemberCountsCoreAsync()
    {
        if (_owned.Count == 0)
        {
            return;
        }

        try
        {
            var counts = await LedgerMemberService.GetActiveMemberCountsAsync(_userId, _owned.Select(l => l.Id).ToList());
            _owned = _owned.Select(l => l with { MemberCount = counts.GetValueOrDefault(l.Id) }).ToList();
            SyncEditingRow();
        }
        catch
        {
            // 成员数只是列表上的附加信息，取不到时保持原值，不打扰用户
        }
    }

    /// <summary>
    /// 列表重新加载后，让正在编辑的那一行指向最新数据（例如默认状态变了）
    /// </summary>
    private void SyncEditingRow()
    {
        if (_editing is not null)
        {
            _editing = _owned.FirstOrDefault(l => l.Id == _editing.Id) ?? _editing;
        }
    }

    private void OnPageClosed(object? sender, PageStackPageClosedEventArgs e)
    {
        if (_disposed || !e.RelativeUri.StartsWith("/ledgers/", StringComparison.Ordinal) || !e.RelativeUri.EndsWith("/members", StringComparison.Ordinal))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await LoadSharedDataAsync();
            StateHasChanged();
        });
    }

    // ------------------------------------------------------------------ 邀请

    private async Task RespondInvitation(InvitationRow invitation, bool accept)
    {
        if (_respondingId is not null)
        {
            return;
        }

        _respondingId = invitation.MemberId;
        try
        {
            await LedgerMemberService.RespondAsync(invitation.MemberId, _userId, accept);
            await PopupService.EnqueueSnackbarAsync(accept ? "已接受邀请" : "已拒绝邀请", AlertTypes.Success);
            await LoadSharedDataAsync();
        }
        catch (Exception ex)
        {
            // 云端的业务错误（邀请已被处理、账本已删除……）取其中的说明，不把「请求失败: NotFound - {…}」整串露给用户；
            // 与成员页共用同一套失败文案规则（给用户的提示不带内部细节，真正的原因记在日志里）
            Logger.LogWarning(ex, "响应共享账本邀请失败：成员关系 {MemberId}，接受={Accept}", invitation.MemberId, accept);
            var failure = LedgerMemberPresentation.DescribeFailure("操作", ex);
            await PopupService.EnqueueSnackbarAsync(failure.Message, failure.IsWarning ? AlertTypes.Warning : AlertTypes.Error);
        }
        finally
        {
            _respondingId = null;
        }
    }

    // ------------------------------------------------------------------ 新建 / 编辑

    private void OpenCreate()
    {
        _editing = null;
        _sheetVisible = true;
    }

    private void OpenEdit(OwnedLedgerRow ledger)
    {
        _editing = ledger;
        _sheetVisible = true;
    }

    /// <summary>表单的初始值：编辑时取正在编辑的那一行；新建时为空</summary>
    private LedgerFormTarget? FormTarget => _editing is { } row ? new LedgerFormTarget(row.Id, row.Name, row.Icon, row.SortOrder) : null;

    // Sheet 退出动画结束后清理「正在编辑」（动画期间保持原内容，避免闪动）
    private void OnSheetClosed() => _editing = null;

    // 保存成功（Sheet 已被要求收起）：重新加载列表与成员数
    private async Task OnLedgerSavedAsync()
    {
        await LoadOwnedAsync();
        await RefreshMemberCountsAsync();
    }

    // ------------------------------------------------------------------ 设为默认

    private async Task OnDefaultToggled(bool makeDefault)
    {
        if (_editing is { } editing)
        {
            await SetDefaultAsync(editing, makeDefault);
        }
    }

    private async Task SetDefaultAsync(OwnedLedgerRow ledger, bool makeDefault)
    {
        try
        {
            var result = await DataGate.RunAsync(() => UserDefaultService.SetDefaultLedgerAsync(_userId, makeDefault ? ledger.Id : null));

            if (result)
            {
                await PopupService.EnqueueSnackbarAsync(makeDefault ? "已设置为默认账本" : "已取消默认账本", AlertTypes.Success);
                await LoadOwnedAsync();
                await RefreshMemberCountsAsync();
            }
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"操作失败: {ex.GetUserMessage()}", AlertTypes.Error);
        }
    }

    // ------------------------------------------------------------------ 删除

    private void AskDelete(OwnedLedgerRow ledger)
    {
        _deleteTarget = ledger;
        _deleteVisible = true;
    }

    private void OnDeleteClosed()
    {
        _deleteTarget = null;
    }

    private async Task DeleteConfirmedAsync()
    {
        // Alert 先于 OnConfirm 关闭，此时 _deleteTarget 仍有值（清理发生在退出动画结束后的 OnClosed）
        if (_deleteTarget is not { } ledger)
        {
            return;
        }

        try
        {
            var result = await DataGate.RunAsync(() => LedgerService.DeleteLedgerAsync(ledger.Id, _userId));

            if (result)
            {
                await PopupService.EnqueueSnackbarAsync("账本删除成功", AlertTypes.Success);

                if (_editing?.Id == ledger.Id)
                {
                    _sheetVisible = false;
                }

                await LoadOwnedAsync();
                await RefreshMemberCountsAsync();
            }
            else
            {
                await PopupService.EnqueueSnackbarAsync("账本不存在", AlertTypes.Warning);
            }
        }
        catch (InvalidOperationException ex)
        {
            await PopupService.EnqueueSnackbarAsync(ex.Message, AlertTypes.Warning);
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"删除失败: {ex.GetUserMessage()}", AlertTypes.Error);
        }
    }

    // ------------------------------------------------------------------ 共享

    private void OpenShare(OwnedLedgerRow ledger)
    {
        _shareTarget = ledger;
        _shareVisible = true;
    }

    private void OnShareClosed()
    {
        _shareTarget = null;
    }

    private void InviteFromShare()
    {
        if (_shareTarget is { } ledger)
        {
            NavigateToMembers(ledger.Id);
        }
    }

    private void NavigateToMembers(Guid ledgerId)
    {
        // 进入成员页前收起编辑 Sheet：返回时页面是干净的
        _sheetVisible = false;
        NavController.Push($"/ledgers/{ledgerId}/members");
    }

    /// <summary>
    /// 复制账本分享信息到剪贴板（JS 剪贴板 API 返回 Promise，JS interop 会自动等待其完成）
    /// </summary>
    private async Task CopyShareInfoAsync()
    {
        if (_shareTarget is not { } ledger)
        {
            return;
        }

        try
        {
            var text = $"我在「记账本」创建了账本「{ledger.Name}」，快加入一起记账吧！";
            await JSRuntime.InvokeAsync<string>("navigator.clipboard.writeText", text);
            await PopupService.EnqueueSnackbarAsync("账本信息已复制，快去粘贴给好友吧", AlertTypes.Success);
        }
        catch (Exception)
        {
            await PopupService.EnqueueSnackbarAsync("复制失败，请手动复制账本名称", AlertTypes.Warning);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        NavController.PageClosed -= OnPageClosed;
    }
}
