@page "/login"
@layout AuthLayout
@using FinanceTracker.Core.Interfaces
@using FinanceTracker.Shared.Validators
@using FinanceTracker.Web.Services
@inject IAuthService AuthService
@inject AuthenticationService AuthStateService
@inject NavigationManager Navigation
@inject IPopupService PopupService

<MContainer Style="max-width: 400px; margin-top: 100px;">
    <MCard>
        <MCardTitle Class="text-center">
            <MIcon Large Color="primary" Class="mb-2">mdi-wallet</MIcon>
            <div class="text-h4 font-weight-bold">记账本</div>
        </MCardTitle>

        <MCardText>
            <MForm @ref="_form" Model="_model" OnValidSubmit="HandleLogin">
                <MTextField @bind-Value="_model.PhoneNumber"
                            Placeholder="请输入手机号"
                            Outlined
                            Dense
                            Rules="PhoneNumberRules"
                            Type="tel"
                            maxlength="11">
                    <PrependInnerContent>
                        <MIcon>mdi-phone</MIcon>
                    </PrependInnerContent>
                </MTextField>

                <MButton Type="submit"
                         Color="primary"
                         Block
                         Large
                         Loading="_loading"
                         Disabled="_loading">
                    登录/注册
                </MButton>
            </MForm>
        </MCardText>

        <MCardActions Class="px-4 pb-4">
            <MAlert Type="AlertTypes.Info" Dense Text Class="mb-0">
                首次使用手机号将自动注册
            </MAlert>
        </MCardActions>
    </MCard>
</MContainer>

@code {
    private MForm? _form;
    private LoginModel _model = new();
    private bool _loading;

    private List<Func<string, StringBoolean>> PhoneNumberRules => new()
    {
        value =>
        {
            var result = PhoneValidator.Validate(value);
            return result.IsValid ? true : result.ErrorMessage!;
        }
    };

    private async Task HandleLogin()
    {
        if (_loading) return;

        _loading = true;

        try
        {
            // 调用本地服务进行登录
            var user = await AuthService.RegisterOrLoginAsync(_model.PhoneNumber);

            // 保存用户信息
            await AuthStateService.SaveUserInfoAsync(user.Id, user.PhoneNumber);

            // 返回首页
            Navigation.NavigateTo("/", replace: true);
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"登录失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginModel
    {
        public string PhoneNumber { get; set; } = string.Empty;
    }
}
