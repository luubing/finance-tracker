@page "/statistics"
@using FinanceTracker.Core.Interfaces
@using FinanceTracker.Core.Enums
@using FinanceTracker.Web.Services
@using FinanceTracker.Web.Components.Charts
@implements IDisposable
@inject IStatisticsService StatisticsService
@inject ILedgerService LedgerService
@inject IJSRuntime JSRuntime
@inject IPopupService PopupService
@inject BillEventService BillEventService
@inject IBudgetService BudgetService

<PStackPageBar Title="月度统计"
               CenterTitle
               Flat
               Color="primary">
    <ActionContent>
        <MButton Icon Disabled="_isRefreshing" OnClick="RefreshStatistics">
            <MIcon Color="white" Class="@(_isRefreshing ? "mdi-spin" : null)">mdi-refresh</MIcon>
        </MButton>
    </ActionContent>
</PStackPageBar>

<MContainer Style="height: calc(100vh - 56px); overflow-y: scroll;">
    <!-- 月份选择器 -->
    <MRow Align="AlignTypes.Center">
        <MCol Cols="4">
            <MButton Icon OnClick="PreviousMonth">
                <MIcon>mdi-chevron-left</MIcon>
            </MButton>
        </MCol>
        <MCol Cols="4" Class="text-center">
            <div class="text-subtitle-1 text-no-wrap">@_currentYear 年 @_currentMonth 月</div>
        </MCol>
        <MCol Cols="4" Class="text-right">
            <MButton Icon OnClick="NextMonth">
                <MIcon>mdi-chevron-right</MIcon>
            </MButton>
        </MCol>
    </MRow>

    <!-- 账本筛选 -->
    @if (_ledgers.Any())
    {
        <MRow>
            <MCol Cols="12">
                <MSelect Value="_selectedLedgerId"
                         ValueChanged="@((Guid? v) => OnLedgerChanged(v))"
                         Items="_ledgers"
                         ItemText="l => l.Name"
                         ItemValue="l => (Guid?)l.Id"
                         Label="账本（全部账本）"
                         Outlined
                         Dense
                         Clearable
                         HideDetails="true" />
            </MCol>
        </MRow>
    }

      
    @if (_isLoading)
    {
        <MContainer Class="d-flex justify-center align-center" Style="height: 200px;">
            <MProgressCircular Indeterminate Size="64" Color="primary" />
        </MContainer>
    }
    else
    {
        <!-- 统计卡片 -->
        <MRow Dense Class="mb-0">
            <MCol Cols="4" Class="d-flex">
                <MCard Color="error" Dark Class="flex-grow-1">
                    <MCardText Class="text-center py-2">
                        <div class="text-caption">总支出</div>
                        <div class="text-subtitle-2 text-no-wrap">¥@_monthlyStats?.TotalExpense.ToString("N2")</div>
                    </MCardText>
                </MCard>
            </MCol>
            <MCol Cols="4" Class="d-flex">
                <MCard Color="success" Dark Class="flex-grow-1">
                    <MCardText Class="text-center py-2">
                        <div class="text-caption">总收入</div>
                        <div class="text-subtitle-2 text-no-wrap">¥@_monthlyStats?.TotalIncome.ToString("N2")</div>
                    </MCardText>
                </MCard>
            </MCol>
            <MCol Cols="4" Class="d-flex">
                <MCard Color="@(_monthlyStats?.NetIncome >= 0 ? "success" : "error")" Dark Class="flex-grow-1">
                    <MCardText Class="text-center py-2">
                        <div class="text-caption">净收支</div>
                        <div class="text-subtitle-2 text-no-wrap">¥@_monthlyStats?.NetIncome.ToString("N2")</div>
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>

        <!-- 预算执行情况 -->
        @if (_budgetStatuses.Any())
        {
            <MRow Class="mt-0 mb-0">
                <MCol Cols="12">
                    <MCard>
                        <MCardTitle>
                            <MIcon Class="mr-2">mdi-wallet</MIcon>
                            预算执行情况
                        </MCardTitle>
                        <MCardText>
                            @foreach (var status in _budgetStatuses)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-space-between text-body-2">
                                        <span>
                                            @status.CategoryIcon @status.CategoryName
                                            @if (status.LedgerName != null)
                                            {
                                                <span class="text--secondary">（@status.LedgerName）</span>
                                            }
                                        </span>
                                        <span class="@(status.RemainingAmount < 0 ? "error--text" : null)">
                                            @status.UsedAmount.ToString("N2") / @status.Amount.ToString("N2")
                                        </span>
                                    </div>
                                    <MProgressLinear Value="@((double)Math.Min(status.UsagePercentage, 100m))"
                                                     Color="@GetBudgetProgressColor(status.UsagePercentage)"
                                                     Height="6"
                                                     Rounded
                                                     Class="mt-1" />
                                    <div class="text-caption text--secondary mt-1">
                                        已使用 @status.UsagePercentage.ToString("0.0")%，剩余 ¥@status.RemainingAmount.ToString("N2")
                                        @if (status.UsagePercentage >= 100)
                                        {
                                            <span class="error--text">（已超支）</span>
                                        }
                                        else if (status.UsagePercentage >= 80)
                                        {
                                            <span class="warning--text">（接近预算上限）</span>
                                        }
                                    </div>
                                </div>
                            }
                        </MCardText>
                    </MCard>
                </MCol>
            </MRow>
        }

        <!-- 支出分类饼图 -->
        <MRow Class="mt-0 mb-0">
            <MCol Cols="12">
                <MCard>
                    <MCardTitle>
                        <MIcon Class="mr-2">mdi-chart-pie</MIcon>
                        支出分类统计
                    </MCardTitle>
                    <MCardText>
                        @if (_expenseCategories.Any())
                        {
                            <MRow>
                                <MCol Cols="12" Md="6">
                                    <MECharts Option="@_expensePieOption" Height="300" />
                                </MCol>
                                <MCol Cols="12" Md="6">
                                    <MList>
                                        @foreach (var category in _expenseCategories)
                                        {
                                            <MListItem>
                                                <MListItemIcon>
                                                    <MIcon>@category.CategoryIcon</MIcon>
                                                </MListItemIcon>
                                                <MListItemContent>
                                                    <MListItemTitle>@category.CategoryName</MListItemTitle>
                                                    <MListItemSubtitle>@category.Percentage% (@category.Count 笔)</MListItemSubtitle>
                                                </MListItemContent>
                                                <MListItemAction>
                                                    <span class="error--text">¥@category.Amount.ToString("N2")</span>
                                                </MListItemAction>
                                            </MListItem>
                                        }
                                    </MList>
                                </MCol>
                            </MRow>
                        }
                        else
                        {
                            <div class="text-center text--secondary py-4">暂无支出数据</div>
                        }
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>

        <!-- 收入分类饼图 -->
        <MRow Class="mb-0 mt-0">
            <MCol Cols="12">
                <MCard>
                    <MCardTitle>
                        <MIcon Class="mr-2">mdi-chart-pie</MIcon>
                        收入分类统计
                    </MCardTitle>
                    <MCardText>
                        @if (_incomeCategories.Any())
                        {
                            <MRow>
                                <MCol Cols="12" Md="6">
                                    <MECharts Option="@_incomePieOption" Height="300" />
                                </MCol>
                                <MCol Cols="12" Md="6">
                                    <MList>
                                        @foreach (var category in _incomeCategories)
                                        {
                                            <MListItem>
                                                <MListItemIcon>
                                                    <MIcon>@category.CategoryIcon</MIcon>
                                                </MListItemIcon>
                                                <MListItemContent>
                                                    <MListItemTitle>@category.CategoryName</MListItemTitle>
                                                    <MListItemSubtitle>@category.Percentage% (@category.Count 笔)</MListItemSubtitle>
                                                </MListItemContent>
                                                <MListItemAction>
                                                    <span class="success--text">¥@category.Amount.ToString("N2")</span>
                                                </MListItemAction>
                                            </MListItem>
                                        }
                                    </MList>
                                </MCol>
                            </MRow>
                        }
                        else
                        {
                            <div class="text-center text--secondary py-4">暂无收入数据</div>
                        }
                    </MCardText>
                </MCard>
            </MCol>
        </MRow>

        <!-- 数据可视化增强（issue 19）：排行 / 热力图 / 累计曲线 / 构成对比 -->
        <ChartCard Title="分类支出排行"
                   Subtitle="@($"{_currentYear}年{_currentMonth}月 Top 8")"
                   Icon="mdi-chart-bar-stacked"
                   IsLoading="_isLoading"
                   IsEmpty="!_expenseCategories.Any()">
            <CategoryRankChart Categories="_expenseCategories" TopN="8" />
        </ChartCard>

        <ChartCard Title="支出日历热力图"
                   Subtitle="@($"{_currentYear}年{_currentMonth}月")"
                   Icon="mdi-calendar-month"
                   IsLoading="_isLoading"
                   IsEmpty="!_dailyTrend.Any(t => t.Expense > 0)"
                   EmptyText="当月暂无支出记录">
            <CalendarHeatmapChart DailyData="_dailyTrend" Year="_currentYear" Month="_currentMonth" />
        </ChartCard>

        <ChartCard Title="累计收支曲线"
                   Subtitle="@($"{_currentYear}年{_currentMonth}月")"
                   Icon="mdi-chart-areaspline"
                   IsLoading="_isLoading"
                   IsEmpty="!_dailyTrend.Any()"
                   EmptyText="当月暂无收支记录">
            <CumulativeNetChart DailyData="_dailyTrend" Year="_currentYear" Month="_currentMonth" />
        </ChartCard>

        <ChartCard Title="支出/收入构成对比"
                   Subtitle="@($"{_currentYear}年{_currentMonth}月")"
                   Icon="mdi-chart-donut"
                   IsLoading="_isLoading"
                   IsEmpty="!_expenseCategories.Any() && !_incomeCategories.Any()"
                   EmptyText="当月暂无收支记录">
            <ExpenseIncomeDonutChart ExpenseCategories="_expenseCategories" IncomeCategories="_incomeCategories" />
        </ChartCard>
    }
</MContainer>

@code {
    private int _currentYear = DateTime.Now.Year;
    private int _currentMonth = DateTime.Now.Month;
    private bool _isLoading = true;

    private MonthlyStatisticsModel? _monthlyStats;
    private List<CategoryStatistics> _expenseCategories = new();
    private List<CategoryStatistics> _incomeCategories = new();
    private object? _expensePieOption;
    private object? _incomePieOption;

    // 预算执行情况（随月份/账本筛选联动）
    private List<BudgetStatus> _budgetStatuses = new();

    // 日粒度趋势数据（热力图/累计曲线用，随月份/账本筛选联动）
    private List<TrendData> _dailyTrend = new();

    private Guid _userId;

    // 账本筛选
    private Guid? _selectedLedgerId;
    private List<LedgerModel> _ledgers = new();

    // 手动刷新状态
    private bool _isRefreshing;

    protected override void OnInitialized()
    {
        BillEventService.BillChanged += OnBillChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var userIdStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
        if (!string.IsNullOrEmpty(userIdStr) && Guid.TryParse(userIdStr, out var userId))
        {
            _userId = userId;
        }

        await LoadLedgersAsync();
        await LoadStatistics();
    }

    private async void OnBillChanged()
    {
        try
        {
            await LoadStatistics();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // 静默处理，避免事件回调中的异常影响其他组件
        }
    }

    public void Dispose()
    {
        BillEventService.BillChanged -= OnBillChanged;
    }

    /// <summary>
    /// 手动刷新当前月份的统计数据
    /// </summary>
    private async Task RefreshStatistics()
    {
        if (_isRefreshing)
        {
            return;
        }

        _isRefreshing = true;
        StateHasChanged();

        try
        {
            await LoadStatistics();
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 加载用户的账本列表（用于账本筛选）
    /// </summary>
    private async Task LoadLedgersAsync()
    {
        try
        {
            var ledgers = await LedgerService.GetLedgersAsync(_userId);
            _ledgers = ledgers.Select(l => new LedgerModel
            {
                Id = l.Id,
                Name = l.Name,
                Icon = l.Icon
            }).ToList();
        }
        catch
        {
            // 账本加载失败不影响统计展示
            _ledgers = new List<LedgerModel>();
        }
    }

    /// <summary>
    /// 账本筛选变更后重新加载统计数据
    /// </summary>
    private async Task OnLedgerChanged(Guid? ledgerId)
    {
        _selectedLedgerId = ledgerId;
        await LoadStatistics();
    }

    private async Task LoadStatistics()
    {
        _isLoading = true;

        try
        {
            // 加载月度统计
            var stats = await StatisticsService.GetMonthlyStatisticsAsync(_userId, _currentYear, _currentMonth, _selectedLedgerId);
            _monthlyStats = new MonthlyStatisticsModel
            {
                TotalExpense = stats.TotalExpense,
                TotalIncome = stats.TotalIncome,
                NetIncome = stats.NetIncome,
                BillCount = stats.BillCount
            };

            // 加载支出分类统计
            var expenseStats = await StatisticsService.GetCategoryStatisticsAsync(_userId, _currentYear, _currentMonth, BillType.Expense, _selectedLedgerId);
            _expenseCategories = expenseStats;

            _expensePieOption = BuildPieOption(_expenseCategories, "支出分类");

            // 加载收入分类统计
            var incomeStats = await StatisticsService.GetCategoryStatisticsAsync(_userId, _currentYear, _currentMonth, BillType.Income, _selectedLedgerId);
            _incomeCategories = incomeStats;

            _incomePieOption = BuildPieOption(_incomeCategories, "收入分类");

            // 加载预算执行情况
            _budgetStatuses = await BudgetService.GetBudgetStatusAsync(_userId, _currentYear, _currentMonth, _selectedLedgerId);

            // 加载日粒度趋势数据（热力图/累计曲线）
            var monthStart = new DateTime(_currentYear, _currentMonth, 1);
            var monthEnd = monthStart.AddMonths(1).AddSeconds(-1);
            _dailyTrend = await StatisticsService.GetTrendDataAsync(
                _userId, monthStart, monthEnd, "day", _selectedLedgerId);
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"加载失败: {ex.Message}", AlertTypes.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// 预算进度条颜色：≥100% 红色超支，≥80% 黄色预警，其余主题色
    /// </summary>
    private string GetBudgetProgressColor(decimal usagePercentage)
    {
        return usagePercentage switch
        {
            >= 100 => "error",
            >= 80 => "warning",
            _ => "primary"
        };
    }

    private object BuildPieOption(List<CategoryStatistics> categories, string title)
    {
        return new
        {
            title = new { text = title, left = "center" },
            tooltip = new { trigger = "item", formatter = "{b}: ¥{c} ({d}%)" },
            legend = new { orient = "vertical", left = "left" },
            series = new[]
            {
                new
                {
                    name = title,
                    type = "pie",
                    radius = "50%",
                    data = categories.Select(c => new { name = c.CategoryName, value = c.Amount }).ToArray(),
                    emphasis = new
                    {
                        itemStyle = new
                        {
                            shadowBlur = 10,
                            shadowOffsetX = 0,
                            shadowColor = "rgba(0, 0, 0, 0.5)"
                        }
                    }
                }
            }
        };
    }

    private async Task PreviousMonth()
    {
        _currentMonth--;
        if (_currentMonth < 1)
        {
            _currentMonth = 12;
            _currentYear--;
        }
        await LoadStatistics();
    }

    private async Task NextMonth()
    {
        _currentMonth++;
        if (_currentMonth > 12)
        {
            _currentMonth = 1;
            _currentYear++;
        }
        await LoadStatistics();
    }

    private class MonthlyStatisticsModel
    {
        public decimal TotalExpense { get; set; }
        public decimal TotalIncome { get; set; }
        public decimal NetIncome { get; set; }
        public int BillCount { get; set; }
    }

    private class LedgerModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
    }
}
