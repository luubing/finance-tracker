@* 复用组件的行为层：全局只放一个（Main.razor 根部）。本身不渲染任何内容，只在电路接管后加载 wwwroot/js/ui.js
   并安装文档级事件委托（左滑行手势、底部 Sheet 拖拽收起）。组件标记见 Components/Ui，样式见 wwwroot/css/ui.css。
   同时把宿主的渲染档位同步成根开关 <html data-ft-solid>（23 号）：IRenderingProfileService.PreferSolidMaterials 为真
   （Android 低端设备 / iOS 系统「降低透明度」）时，设计令牌把所有玻璃表面换成不透明实色；变化事件（用户在系统里切换）即时跟随。 *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IRenderingProfileService RenderingProfile

@code {
    private const string ModulePath = "./_content/FinanceTracker.Web/js/ui.js";

    private IJSObjectReference? _module;
    private bool _subscribed;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 预渲染阶段不会走到这里；电路接管后再安装，避免 Blazor Server 预渲染时调用 JS
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _module.InvokeVoidAsync("install");
            if (_disposed)
            {
                return;
            }

            // 先订阅再读当前值：两者之间发生的变化不会丢（事件里再同步一次即可）
            RenderingProfile.PreferSolidMaterialsChanged += OnPreferSolidMaterialsChanged;
            _subscribed = true;
            await _module.InvokeVoidAsync("setSolid", RenderingProfile.PreferSolidMaterials);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // 电路已断开或脚本加载失败：左滑 / 拖拽收起只是手势增强，点按等价入口不受影响；材质降级失败时保持默认的玻璃质感
        }
    }

    /// <summary>宿主的渲染档位变化（可能在任意线程触发）：切回电路的同步上下文再写根开关。</summary>
    private void OnPreferSolidMaterialsChanged(object? sender, bool solid)
    {
        if (!_disposed)
        {
            _ = ApplySolidAsync(solid);
        }
    }

    private async Task ApplySolidAsync(bool solid)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_module is not null && !_disposed)
                {
                    await _module.InvokeVoidAsync("setSolid", solid);
                }
            });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            // 电路已断开 / 组件已释放：随它去
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_subscribed)
        {
            RenderingProfile.PreferSolidMaterialsChanged -= OnPreferSolidMaterialsChanged;
            _subscribed = false;
        }

        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("uninstall");
            await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException)
        {
        }
    }
}
