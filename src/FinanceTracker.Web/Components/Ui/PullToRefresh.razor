@namespace FinanceTracker.Web.Components.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    下拉刷新区（设计稿 07）：放在可滚动页面内容的最上方（首页放在 Hero 里面，列表页放在列表上方）。
    - 手势由 wwwroot/js/pullRefresh.js 接管：滚动容器（最近的 [data-scroll-root] 祖先）停在顶部时向下拉，
      区的高度跟着手指增长，松手时过了阈值就调用 OnRefresh，等它完成后收起。
    - 只刷新当前页的数据：本组件不知道刷新什么，更不会触发云端同步——页面在 OnRefresh 里决定做什么。
    - 下拉是四个 Tab 唯一的刷新入口（ADR 0007）：导航栏不放刷新按钮（设计稿本来也没有），
      所以桌面浏览器没有触摸时没有等价入口（可用浏览器自带的刷新）；新增依赖本组件的页面不要再补按钮入口，除非先改 ADR 里的这条决定。
    - 观察属性（E2E）：区的 data-testid（默认 pull-refresh）、data-state = idle | pulling | ready | refreshing | settling、
      样式变量 --ft-ptr-offset（当前高度）与 --ft-ptr-progress（0–1，到阈值为 1）；这些由脚本写入，Blazor 重绘不会冲掉。
    - 读屏：状态文字（正在刷新 / 刷新完成）写在 role="status" 的隐藏文本里。
*@
<div class="ft-ptr" @ref="_zone" data-testid="@TestId">
    <span class="ft-ptr__spinner" aria-hidden="true"></span>
    <span class="ft-ptr__text" data-ptr-status role="status" aria-live="polite"></span>
</div>

@code {
    private const string ModulePath = "./_content/FinanceTracker.Web/js/pullRefresh.js";

    private ElementReference _zone;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<PullToRefresh>? _self;
    private bool _disposed;

    /// <summary>松手过了阈值时触发；返回的 Task 完成就表示刷新结束，转圈随之收起</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    /// <summary>E2E 钩子</summary>
    [Parameter] public string? TestId { get; set; } = "pull-refresh";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (_disposed)
            {
                return;
            }

            _self = DotNetObjectReference.Create(this);
            _controller = await _module.InvokeAsync<IJSObjectReference>("attach", _zone, _self);
        }
        catch (Exception ex) when (IsJsTeardown(ex) || ex is JSException)
        {
            // 电路已断开 / 组件已销毁，或脚本加载失败：下拉刷新只是手势增强，页面照常可用（页面仍会随账单变更、二级页面关闭自动重读）
        }
    }

    /// <summary>
    /// 由脚本在松手过阈值时调用；脚本等这个调用返回才收起转圈
    /// </summary>
    [JSInvokable]
    public async Task OnPulled()
    {
        if (_disposed)
        {
            return;
        }

        await OnRefresh.InvokeAsync();
    }

    private static bool IsJsTeardown(Exception ex) =>
        ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or OperationCanceledException;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        try
        {
            if (_controller is not null)
            {
                await _controller.InvokeVoidAsync("dispose");
                await _controller.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (IsJsTeardown(ex))
        {
            // 电路已断开：监听随页面一起销毁，无需清理
        }

        _self?.Dispose();
    }
}
