@namespace FinanceTracker.Web.Components.Ui
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    弹出菜单（设计稿 04 · 账本菜单 / 支付渠道菜单）：从一行（Anchor）旁弹出的选项列表，iOS 上下文菜单的样子。
    - 位置：优先在触发行下方、右缘对齐；下方放不下就放上方；都放不下就选空间大的一侧并在菜单内滚动。
      定位由 ui.js 的 positionPopover 完成（用 fixed 坐标，菜单因此不受 Sheet 内容区的滚动裁剪）：
      定位前菜单是 visibility: hidden（不在原点闪一下），定位后脚本写 data-positioned 才显示。
    - 竖向范围从安全区往里量：上沿 = 顶部安全区 + 12（与全高 Sheet 自己的上沿同一条线，菜单不会冲进状态栏 / 刘海），
      下沿 = 屏高 − 底部安全区 − 12（不压手势条）。要滚动时可视区收成「整数项 + 半项」（最后一项露半截 = 还能滚的提示），
      并把当前选中项（aria-checked）滚进可视区。
      脚本加载失败 / 没有触发行时降级为贴着屏幕底部的列表（data-fallback），功能不丢。
    - 收起：点菜单外的任何地方（透明的整屏点击层，同时挡住下面的点击——点外面只是收起，不会误触下面的行）、Esc、选了某一项。
      选项（PopoverMenuItem）点击后由它通过级联值通知菜单收起，所以调用方只处理「选了什么」。
    - 不是玻璃：纯白卡片 + 投影（玻璃层预算已被 Tab 栏与导航按钮用完，见 ADR 0007 §3），层级 --ft-z-popover 在 Sheet 之上、Alert 之下。
    - 观察属性（E2E）：菜单 data-testid（默认 popover），点击层 data-testid="{TestId}-layer"；data-placement="below|above"。
*@
@if (Visible)
{
    <div class="ft-popover-layer"
         data-testid="@(TestId is null ? "popover-layer" : TestId + "-layer")"
         @onclick="CloseAsync">
        <div class="ft-popover"
             @ref="_menu"
             role="menu"
             tabindex="-1"
             aria-label="@AriaLabel"
             data-testid="@(TestId ?? "popover")"
             data-fallback="@(_fallback ? "true" : null)"
             @onclick:stopPropagation
             @onkeydown="OnKeyDownAsync">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
    </div>
}

@code {
    private const string ModulePath = "./_content/FinanceTracker.Web/js/ui.js";

    private ElementReference _menu;
    private IJSObjectReference? _module;
    private bool _positioned;
    private bool _fallback;

    /// <summary>是否显示</summary>
    [Parameter] public bool Visible { get; set; }

    /// <summary>显示状态变化（点外面 / Esc / 选了某一项时回写 false）</summary>
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>触发行：菜单相对它定位。没给时降级为屏幕底部的列表</summary>
    [Parameter] public ElementReference? Anchor { get; set; }

    /// <summary>菜单的读屏名称（例如「选择账本」）</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>E2E 钩子：菜单的 data-testid</summary>
    [Parameter] public string? TestId { get; set; }

    /// <summary>菜单项（PopoverMenuItem）</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>收起菜单（点击层、Esc、选项点击后调用）</summary>
    public async Task CloseAsync()
    {
        if (!Visible)
        {
            return;
        }

        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Visible)
        {
            // 菜单已卸载：下次打开要重新定位、重新判断降级
            _positioned = false;
            _fallback = false;
            return;
        }

        if (_positioned)
        {
            return;
        }

        _positioned = true;

        try
        {
            if (Anchor is not { } anchor)
            {
                UseFallback();
                return;
            }

            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _module.InvokeVoidAsync("positionPopover", _menu, anchor);
            await _menu.FocusAsync(preventScroll: true);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or ArgumentException)
        {
            // 脚本加载失败、触发行元素已被替换：降级为底部列表，菜单照常可用
            UseFallback();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // 电路已断开 / 组件已销毁：什么也不用做
        }
    }

    private void UseFallback()
    {
        _fallback = true;
        StateHasChanged();
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException)
        {
        }
    }
}
