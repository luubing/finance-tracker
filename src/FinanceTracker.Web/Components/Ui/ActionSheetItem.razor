@namespace FinanceTracker.Web.Components.Ui

@* 操作菜单里的一项：先收起所在的 ActionSheet，再触发 OnClick。Destructive 为红字（删除 / 退出） *@
<button type="button"
        class="ft-actionsheet__item @(Destructive ? "ft-actionsheet__item--danger" : null)"
        disabled="@Disabled"
        data-testid="@TestId"
        @onclick="HandleClickAsync"
        @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="mdi @Icon" aria-hidden="true"></i>
    }
    <span>@ChildContent</span>
</button>

@code {
    [CascadingParameter] private ActionSheet? Sheet { get; set; }

    /// <summary>MDI 图标类名（可选）</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>红字：破坏性操作</summary>
    [Parameter] public bool Destructive { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>E2E 钩子</summary>
    [Parameter] public string? TestId { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleClickAsync()
    {
        if (Sheet != null)
        {
            await Sheet.CloseAsync();
        }

        await OnClick.InvokeAsync();
    }
}
