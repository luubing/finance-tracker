@namespace FinanceTracker.Web.Components.Ui
@inject IPopupService PopupService

@*
    「名称 + 图标 + 排序」的新建 / 编辑底部 Sheet（分类与支付渠道共用；账本的表单是 LedgerFormSheet，结构相同）。
    - Editing 为空是新建，否则是编辑；名称校验、图标选择、保存中状态、成功 / 失败提示都在这里，
      真正落库交给调用方的 Save（它调用各自的服务，服务层校验不变；失败时抛出异常即可，这里负责提示）。
    - FormExtras 插槽放表单自有的附加设置（新建、编辑都显示，例如分类的「不计入统计」开关），状态由调用方持有、随 Save 落库。
    - 编辑模式下 EditingExtras 插槽放页面自己的操作（设为默认、删除）：它们依赖页面状态与回调，不属于表单本身。
    - 观察属性（E2E）：{前缀}-sheet、{前缀}-name、{前缀}-sort、{前缀}-form-error、{前缀}-save，
      以及 BottomSheet 自带的 sheet-title / sheet-close、IconPicker 的 icon-picker。
*@
<BottomSheet Visible="Visible"
             VisibleChanged="VisibleChanged"
             Title="@(Editing is null ? $"新建{Noun}" : $"编辑{Noun}")"
             Dismissible="@(!_saving)"
             OnClosed="HandleClosedAsync"
             TestId="@($"{TestIdPrefix}-sheet")">
    <form class="ft-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="ft-sheet-preview">
            <span class="ft-tile ft-tile--soft ft-tile--@PreviewTone" aria-hidden="true"><i class="mdi @ManagedItemPresentation.NormalizeIcon(_icon, DefaultIcon)"></i></span>
        </div>

        <GroupedList>
            <label class="ft-field">
                <span class="ft-field__label">名称</span>
                <input class="ft-field__input"
                       type="text"
                       data-testid="@($"{TestIdPrefix}-name")"
                       maxlength="@ManagedItemPresentation.NameMaxLength"
                       placeholder="@NamePlaceholder"
                       autocomplete="off"
                       enterkeyhint="done"
                       value="@_name"
                       @oninput="OnNameInput" />
            </label>
            <label class="ft-field">
                <span class="ft-field__label">排序</span>
                <input class="ft-field__input ft-field__input--end"
                       type="number"
                       inputmode="numeric"
                       data-testid="@($"{TestIdPrefix}-sort")"
                       placeholder="数字越小越靠前"
                       autocomplete="off"
                       value="@_sortOrder"
                       @oninput="OnSortInput" />
            </label>
        </GroupedList>

        <GroupedList Header="图标">
            <IconPicker Choices="IconChoices" @bind-Value="_icon" />
        </GroupedList>

        @FormExtras

        @if (Editing is not null)
        {
            @EditingExtras
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="ft-form-error" role="alert" data-testid="@($"{TestIdPrefix}-form-error")">@_error</div>
        }

        <div class="ft-sheet-actions">
            <GlassButton Kind="ButtonKind.Brand" Large Block Type="submit" Busy="_saving" TestId="@($"{TestIdPrefix}-save")">保存</GlassButton>
        </div>
    </form>
</BottomSheet>

@code {
    /// <summary>是否显示</summary>
    [Parameter] public bool Visible { get; set; }

    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>条目的叫法（「分类」「支付渠道」）：标题、校验提示与成功提示里用</summary>
    [Parameter, EditorRequired] public string Noun { get; set; } = string.Empty;

    /// <summary>观察属性的前缀（category → category-sheet / category-name …）</summary>
    [Parameter, EditorRequired] public string TestIdPrefix { get; set; } = string.Empty;

    /// <summary>名称输入框的占位提示</summary>
    [Parameter] public string? NamePlaceholder { get; set; }

    /// <summary>图标候选</summary>
    [Parameter, EditorRequired] public IReadOnlyList<IconChoice> IconChoices { get; set; } = Array.Empty<IconChoice>();

    /// <summary>新建时的默认图标；图标非法时的回退</summary>
    [Parameter, EditorRequired] public string DefaultIcon { get; set; } = string.Empty;

    /// <summary>预览色块的配色（ui.css 的 .ft-tile--{色}）：编辑时用该条目在列表里的颜色，新建时用灰色</summary>
    [Parameter] public string PreviewTone { get; set; } = "gray";

    /// <summary>要编辑的条目；为空表示新建。打开 Sheet 时按它初始化表单</summary>
    [Parameter] public NameIconTarget? Editing { get; set; }

    /// <summary>
    /// 表单自有的附加设置（新建、编辑都显示；例如分类的「不计入统计」开关），放在图标之后、编辑操作之前。
    /// 它们的状态属于调用方（随 Save 一起落库），这里只提供位置
    /// </summary>
    [Parameter] public RenderFragment? FormExtras { get; set; }

    /// <summary>编辑模式下表单末尾的页面自有操作（设为默认、删除）</summary>
    [Parameter] public RenderFragment? EditingExtras { get; set; }

    /// <summary>
    /// 落库：校验通过后调用，调用方新建或更新条目；失败抛出异常（这里会提示「操作失败」并保持 Sheet 打开，用户可修正后重试）
    /// </summary>
    [Parameter, EditorRequired] public Func<NameIconValues, Task> Save { get; set; } = _ => Task.CompletedTask;

    /// <summary>保存成功（新建或更新）后触发，此时 Sheet 已被要求收起；页面在这里重新加载列表</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>Sheet 退出动画结束、卸载之后触发（页面在这里清理「正在编辑」的状态）</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private string _name = string.Empty;
    private string _icon = string.Empty;
    private int _sortOrder;
    private string? _error;
    private bool _saving;
    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        // 只在「从隐藏变为显示」的那一刻按 Editing 初始化表单；之后页面重绘（例如编辑中切换了默认项）不能冲掉用户正在输入的内容
        if (Visible && !_wasVisible)
        {
            _name = Editing?.Name ?? string.Empty;
            _icon = Editing?.Icon ?? DefaultIcon;
            _sortOrder = Editing?.SortOrder ?? 0;
            _error = null;
            _saving = false;
        }

        _wasVisible = Visible;
    }

    private void OnNameInput(ChangeEventArgs e)
    {
        _name = e.Value?.ToString() ?? string.Empty;
        _error = null;
    }

    private void OnSortInput(ChangeEventArgs e)
    {
        _sortOrder = int.TryParse(e.Value?.ToString(), out var order) ? order : 0;
    }

    private async Task HandleClosedAsync()
    {
        _error = null;
        _saving = false;
        await OnClosed.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _error = ManagedItemPresentation.ValidateName(_name, Noun);
        if (_error is not null)
        {
            return;
        }

        _saving = true;
        try
        {
            var values = new NameIconValues(
                _name.Trim(),
                ManagedItemPresentation.NormalizeIcon(_icon, DefaultIcon),
                _sortOrder);

            await Save(values);
            await PopupService.EnqueueSnackbarAsync(Editing is null ? $"{Noun}创建成功" : $"{Noun}更新成功", AlertTypes.Success);

            await VisibleChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            await PopupService.EnqueueSnackbarAsync($"操作失败: {ex.GetUserMessage()}", AlertTypes.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
